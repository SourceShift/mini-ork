#!/usr/bin/env python3
# .githooks/post-commit — file-reversion watchdog.
#
# Problem this solves: when a framework-edit (or other mini-ork) dispatch
# is running concurrently with a user `git commit`, the dispatch's
# implementer / verifier / publisher / rollback chain (or a subagent like
# codex CLI doing its own sandbox cleanup) sometimes reverts the
# just-committed files in the working tree back to a pre-commit state.
# HEAD is intact, but the working tree files are deleted or reverted.
#
# Root-cause is still under investigation across at least 4 layers
# (publisher cp logic, codex CLI sandbox cleanup, git-worktree-add side
# effects from .mini-ork/worktrees/*, rollback node's keep_*_discard_*
# semantics). Rather than gate on identifying the culprit, this hook
# implements a defensive auto-recovery loop that:
#
# 1. Records the SHA + file list of the new commit at commit time.
# 2. Spawns a detached watchdog that, for the next N seconds, polls the
#    working tree.
# 3. If any file from the commit is missing OR has content matching its
#    HEAD~1 state (i.e. been "reverted" by a racing process), restores it
#    from HEAD via `git checkout HEAD -- <file>` and logs the recovery.
#
# Rebase/sequencer safety (LF-R14): the drift test in (3) also fires while
# git is mid-rebase, and there it is wrong. `git rebase origin/main` checks
# out the new base; for exactly the files our commit touched, that checkout's
# content IS the parent blob the test matches on (the commit is the delta). A
# restore there desyncs the tree from the rebase checkout and wedges the next
# `pick` ("error: Your local changes to the following files would be
# overwritten by merge" … "Could not execute the todo command"). Two
# witnesses on 2026-10-16 wedged `make worktree-merge` this way.
#
# So the watchdog now skips instead of healing when either:
#
#   * an operation is in progress — `rebase-merge` / `rebase-apply` /
#     `MERGE_HEAD` / `CHERRY_PICK_HEAD` / `REVERT_HEAD` exists. Each path is
#     resolved with `git rev-parse --git-path <name>` so the probe is
#     per-worktree (a linked worktree's state lives under
#     `.git/worktrees/<name>/`, not the main checkout's git dir); or
#   * HEAD is no longer the `sha` the watchdog was spawned with. The watchdog's
#     premise was "HEAD is intact, the working tree was reverted" — this makes
#     that premise a precondition. During a rebase / am / cherry-pick / merge
#     HEAD is the operation's own commit, so a drifted blob is that
#     operation's legitimate checkout, not a reversion.
#
# A skip is NOT a recovery: it restores nothing and appends no row to the log
# (the log is a recovery ledger, and a rebase is routine). While HEAD is still
# `sha` and no operation is in progress the pre-existing healing path is
# unchanged. The HEAD-clobber branch-ref repair is deliberately outside the
# HEAD==sha precondition — it exists precisely for the HEAD-moved case — but it
# does stand down while a sequencer operation is in flight.
#
# Escape hatches:
#   MO_REVERSION_GUARD_DISABLED=1 git commit ...   → skip the hook
#   MO_REVERSION_GUARD_WATCH_S=N                   → tune watch window (default 60s)
#   MO_REVERSION_GUARD_POLL_S=N                    → tune poll interval (default 5s)
#
# The recovery log lives at .mini-ork/file-reversion-guard.log.
# Each recovery is a tab-separated row:
#   <iso-timestamp>\t<sha>\t<file>\t<recovered-from-sha>
#
# Ported from bash (bash-removal Phase 4) — semantics preserved line-for-line.
# The watchdog is re-executed as a detached child (`__watchdog__` argv mode)
# instead of a backgrounded subshell; externally observable behavior (log
# format, restore semantics, immediate return) is identical.

import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

_ENV_PREFIX = "_MO_RG_"


def _git(repo_root: str, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", repo_root, *args], capture_output=True, text=True, check=False
    )


def _utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# Sequencer / operation state files, named relative to the repository's git
# dir. `git rev-parse --git-path <name>` resolves each one per-worktree, so the
# existence probe stays correct in a linked worktree.
_IN_PROGRESS_MARKERS = (
    "rebase-merge",     # `git rebase` (merge backend) mid-flight
    "rebase-apply",     # `git rebase` (apply backend) / `git am`
    "MERGE_HEAD",       # `git merge` stopped before committing
    "CHERRY_PICK_HEAD", # `git cherry-pick` with a conflict left in place
    "REVERT_HEAD",      # `git revert` with a conflict left in place
)


def _git_path(repo_root: str, name: str) -> Path:
    """Resolve `git rev-parse --git-path <name>` against the worktree root.

    Git answers relative to the repo root for the main worktree (`.git/...`)
    but absolutely for a linked one, so a relative answer is joined to
    `repo_root` rather than to the current directory.
    """
    out = _git(repo_root, "rev-parse", "--git-path", name).stdout.strip()
    if not out:
        # `git rev-parse` failed (not a git dir) — nothing can be in progress.
        return Path(repo_root) / name
    p = Path(out)
    return p if p.is_absolute() else Path(repo_root) / p


def _operation_in_progress(repo_root: str) -> bool:
    """True while a rebase / am / merge / cherry-pick / revert is mid-flight."""
    return any(_git_path(repo_root, m).exists() for m in _IN_PROGRESS_MARKERS)


def _index_modes(repo_root: str, files: list) -> dict:
    """Index modes for *files*, keyed by path (RB-40).

    ``git diff-tree --name-only`` at commit time carries no mode, so the only
    way to tell a gitlink (160000) from a regular file is the index. Read it
    here, inside the watchdog, rather than threading a new ``_MO_RG_MODES``
    channel from ``main()``: the direct-``_watchdog`` tests set only
    ``_MO_RG_FILES``, and a missing mode must fall back to today's behavior.
    """
    paths = [f for f in files if f]
    if not paths:
        return {}
    r = _git(repo_root, "ls-files", "-s", "--", *paths)
    if r.returncode != 0:
        return {}
    modes = {}
    for line in r.stdout.splitlines():
        meta, tab, path = line.partition("\t")
        fields = meta.split()
        if tab and fields:
            modes[path] = fields[0]
    return modes


def _restored_matches_head(repo_root: str, sha: str, f: str) -> bool:
    """Whether *f* now matches HEAD's blob — i.e. the heal actually landed."""
    head_blob = _git(repo_root, "rev-parse", f"{sha}:{f}").stdout.strip()
    path = Path(repo_root) / f
    if not head_blob or not path.is_file():
        return False
    file_blob = _git(repo_root, "hash-object", str(path)).stdout.strip()
    return bool(file_blob) and file_blob == head_blob


def _watchdog(repo_root: str, sha: str, branch: str, files: list,
              watch_s: int, poll_s: int, log_path: str) -> None:
    end = time.time() + watch_s
    # A path healed but still not matching HEAD is not retried in this process.
    # This must be local, not module-level: the hook re-execs itself as a fresh
    # process for ``__watchdog__``, so a module-level set would be empty on
    # every spawn — the very retry loop this fixes (RB-40).
    noop_healed: set = set()
    modes = _index_modes(repo_root, files)
    with open(log_path, "a", encoding="utf-8") as log:
        while time.time() < end:
            time.sleep(poll_s)

            # ── in-progress-operation guard ───────────────────────────────
            # A rebase / am / cherry-pick / revert / merge rewrites the tree on
            # purpose: the working tree holds the sequencer's own checkout, and
            # for the files our commit touched that checkout IS the parent blob
            # the drift check below restores from. Healing there clobbers the
            # checkout and the next `pick` aborts. Skip the whole poll while one
            # is in flight. A skip is not a recovery, so it logs nothing.
            if _operation_in_progress(repo_root):
                continue

            # ── HEAD-clobber guard ────────────────────────────────────────
            # If we're still on the same branch but its tip was moved OFF our
            # commit to an OLDER commit that does not contain our commit (a
            # sideways/foreign reset, not a legitimate follow-up
            # commit/amend/rebase), restore the branch ref to our SHA. Two
            # conditions keep this from fighting normal git use:
            #   1. our SHA is no longer an ancestor of the tip (orphaned)
            #   2. the new tip is OLDER than our commit (a fresh amend/rebase
            #      would be NEWER, so this only fires on a reset to a
            #      pre-existing/stale commit)
            if branch:
                cur_branch = _git(
                    repo_root, "symbolic-ref", "--quiet", "--short", "HEAD"
                ).stdout.strip()
                cur_tip = _git(
                    repo_root, "rev-parse", "--verify", "-q", "HEAD"
                ).stdout.strip()
                if (
                    cur_branch == branch
                    and cur_tip
                    and cur_tip != sha
                    and _git(
                        repo_root, "merge-base", "--is-ancestor", sha, cur_tip
                    ).returncode
                    != 0
                ):
                    tip_ct = _git(
                        repo_root, "show", "-s", "--format=%ct", cur_tip
                    ).stdout.strip() or "0"
                    our_ct = _git(
                        repo_root, "show", "-s", "--format=%ct", sha
                    ).stdout.strip() or "0"
                    if int(tip_ct) < int(our_ct):
                        if (
                            _git(
                                repo_root,
                                "update-ref",
                                f"refs/heads/{branch}",
                                sha,
                                cur_tip,
                            ).returncode
                            == 0
                        ):
                            log.write(
                                f"{_utc_now()}\t{sha}\t(branch:{branch})\t"
                                f"restored-HEAD-clobbered-from-{cur_tip}\n"
                            )
                            log.flush()

            # ── semantic guard: HEAD must still be our commit ─────────────
            # The premise is "HEAD is intact, the working tree was reverted".
            # Make it a precondition: heal files only while the watched commit
            # is still HEAD. A rebase checks out the new base, so HEAD is the
            # operation's commit and the drifted blob is that checkout, not a
            # reversion. (The branch-ref repair above intentionally stays
            # outside this guard — it exists for the HEAD-moved case.)
            if _git(
                repo_root, "rev-parse", "--verify", "--quiet", "HEAD"
            ).stdout.strip() != sha:
                continue

            for f in files:
                if not f or f in noop_healed:
                    continue
                # RB-40: a gitlink (index mode 160000) or a working-tree
                # directory is not a deleted file. ``is_file()`` is false for
                # both, so the old branch healed them on every poll forever
                # (the `ui` submodule: 48 no-op rows, no effect). Skip before
                # the deleted-file branch; a skip writes no ledger row.
                if modes.get(f) == "160000" or (Path(repo_root) / f).is_dir():
                    continue
                if not (Path(repo_root) / f).is_file():
                    # File deleted — restore from HEAD.
                    if _git(repo_root, "checkout", "HEAD", "--", f).returncode == 0:
                        if _restored_matches_head(repo_root, sha, f):
                            log.write(
                                f"{_utc_now()}\t{sha}\t{f}\t"
                                f"restored-deleted-from-{sha}\n"
                            )
                            log.flush()
                        else:
                            noop_healed.add(f)
                    continue
                # File present — check if content matches HEAD's blob.
                head_blob = _git(repo_root, "rev-parse", f"{sha}:{f}").stdout.strip()
                if not head_blob:
                    continue
                file_blob = _git(
                    repo_root, "hash-object", str(Path(repo_root) / f)
                ).stdout.strip()
                if file_blob and file_blob != head_blob:
                    # Working-tree content drifted from HEAD. Only restore if
                    # the drifted content matches a PARENT commit (i.e. someone
                    # reverted to an earlier state); otherwise it's a
                    # legitimate user edit and we leave it alone.
                    for parent_ref in (f"{sha}^", f"{sha}^^", f"{sha}^^^"):
                        r = _git(repo_root, "rev-parse", f"{parent_ref}:{f}")
                        if r.returncode != 0:
                            continue
                        parent_blob = r.stdout.strip()
                        if file_blob == parent_blob:
                            if (
                                _git(repo_root, "checkout", "HEAD", "--", f).returncode
                                == 0
                            ):
                                if _restored_matches_head(repo_root, sha, f):
                                    parent_sha = _git(
                                        repo_root, "rev-parse", parent_ref
                                    ).stdout.strip()
                                    log.write(
                                        f"{_utc_now()}\t{sha}\t{f}\t"
                                        f"restored-reverted-to-{parent_sha}\n"
                                    )
                                    log.flush()
                                else:
                                    noop_healed.add(f)
                            break


def main() -> int:
    # Detached watchdog mode (spawned by the hook below; git never passes args).
    if len(sys.argv) > 1 and sys.argv[1] == "__watchdog__":
        env = os.environ
        _watchdog(
            repo_root=env[_ENV_PREFIX + "REPO_ROOT"],
            sha=env[_ENV_PREFIX + "SHA"],
            branch=env.get(_ENV_PREFIX + "BRANCH", ""),
            files=env.get(_ENV_PREFIX + "FILES", "").split("\n"),
            watch_s=int(env[_ENV_PREFIX + "WATCH_S"]),
            poll_s=int(env[_ENV_PREFIX + "POLL_S"]),
            log_path=env[_ENV_PREFIX + "LOG"],
        )
        return 0

    if os.environ.get("MO_REVERSION_GUARD_DISABLED", "0") == "1":
        return 0

    r = _git(".", "rev-parse", "--show-toplevel")
    repo_root = r.stdout.strip() if r.returncode == 0 else ""
    if not repo_root:
        return 0
    try:
        os.chdir(repo_root)
    except OSError:
        return 0

    sha = _git(repo_root, "rev-parse", "HEAD").stdout.strip()
    # Branch we committed onto (empty if detached) — used by the HEAD-clobber
    # guard. A racing process (e.g. a confused cross-repo `codex` session) has
    # been observed `git reset`ing HEAD onto an UNRELATED/foreign commit
    # seconds after a commit, orphaning it. The original watchdog assumed
    # "HEAD is intact"; it isn't always, so we guard the branch ref too.
    branch = _git(
        repo_root, "symbolic-ref", "--quiet", "--short", "HEAD"
    ).stdout.strip()
    watch_s = int(os.environ.get("MO_REVERSION_GUARD_WATCH_S", "60"))
    poll_s = int(os.environ.get("MO_REVERSION_GUARD_POLL_S", "5"))
    log_path = str(Path(repo_root) / ".mini-ork" / "file-reversion-guard.log")
    (Path(repo_root) / ".mini-ork").mkdir(parents=True, exist_ok=True)

    # Files this commit added or modified. Deletions in this commit are
    # intentional — don't re-add them.
    files_out = _git(
        repo_root, "diff-tree", "--no-commit-id", "--name-only",
        "--diff-filter=AM", "-r", sha,
    ).stdout.strip()
    if not files_out:
        return 0

    # Spawn a detached watchdog (start_new_session ≈ setsid + disown) so the
    # commit shell can return immediately and the watchdog survives shell exit.
    env = os.environ.copy()
    env[_ENV_PREFIX + "REPO_ROOT"] = repo_root
    env[_ENV_PREFIX + "SHA"] = sha
    env[_ENV_PREFIX + "BRANCH"] = branch
    env[_ENV_PREFIX + "FILES"] = files_out
    env[_ENV_PREFIX + "WATCH_S"] = str(watch_s)
    env[_ENV_PREFIX + "POLL_S"] = str(poll_s)
    env[_ENV_PREFIX + "LOG"] = log_path
    log_fd = open(log_path, "ab", buffering=0)
    try:
        subprocess.Popen(  # noqa: S603
            [sys.executable, os.path.abspath(__file__), "__watchdog__"],
            cwd=repo_root,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=log_fd,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
        )
    finally:
        log_fd.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
