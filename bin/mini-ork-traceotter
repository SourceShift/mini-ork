#!/usr/bin/env bash

# Runtime cutover (bash→Python): MINI_ORK_RUNTIME=python execs the ported module.
{ MINI_ORK_ROOT="${MINI_ORK_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"; [ -f "$MINI_ORK_ROOT/lib/runtime-select.sh" ] && . "$MINI_ORK_ROOT/lib/runtime-select.sh" && mo_runtime_maybe_delegate "${BASH_SOURCE[0]}" "$@"; } || true
# mini-ork traceotter — distill THIS repo's own agent-run trajectories with
# TraceOtter and surface the grounded values (cost, outcome quality, tool
# reliability, distilled skills, and how much is clean enough to train a local
# lane on). No GPU; local; private (redaction on).
#
#   mini-ork traceotter            # analytics on .mini-ork/runs (default)
#   mini-ork traceotter --all      # distill the whole dev history too
#   mini-ork traceotter skills     # print the distilled skills
#   mini-ork traceotter dataset    # emit the LLaMA-Factory SFT dataset + train cmd
set -uo pipefail

TO="${TRACEOTTER_HOME:-/Volumes/docker-ssd/ps/TraceOtter}"
PY="$TO/.venv/bin/python"
HOME_DIR="${MINI_ORK_HOME:-$PWD/.mini-ork}"
RUNS="$HOME_DIR/runs"
OUT="$HOME_DIR/traceotter"
mode="${1:-analytics}"

[ -x "$PY" ] || { echo "[traceotter] not found at $TO (.venv). Set TRACEOTTER_HOME." >&2; exit 2; }
[ -d "$RUNS" ] || { echo "[traceotter] no runs at $RUNS — run some mini-ork tasks first." >&2; exit 2; }

src_args=(--mini-ork "$RUNS")            # the mini-ork adapter (NOT --jsonl, which assumes claude/codex)
if [ "$mode" = "--all" ]; then
  src_args=(--claude "$HOME/.claude/projects" --mini-ork "$RUNS")
  [ -d "$HOME/.codex/sessions" ] && src_args+=(--codex "$HOME/.codex/sessions")
  mode="analytics"
fi

echo "[traceotter] distilling $RUNS → $OUT ..." >&2
"$PY" -m traceotter.cli --json pipeline "${src_args[@]}" --out "$OUT" >/dev/null 2>&1 \
  || { echo "[traceotter] distill failed" >&2; exit 1; }

case "$mode" in
  skills)
    "$PY" - "$OUT" <<'PY'
import json, sys
s = json.load(open(f"{sys.argv[1]}/skills.json"))
print(f"# {len(s)} distilled skills (recurring procedures mined from your runs)\n")
for x in sorted(s, key=lambda k: -(k.get("support") or len(k.get("sourceEpisodeIds", []))))[:20]:
    n = x.get("support") or len(x.get("sourceEpisodeIds", []))
    proc = " → ".join(x.get("procedure", [])[:2])
    print(f"[{n:>4} eps] {x.get('skillId','?')}: {proc[:110]}")
PY
    ;;
  dataset)
    "$PY" - "$OUT" <<'PY'
import json, sys
r = json.load(open(f"{sys.argv[1]}/report.json"))
lf = r["llamafactory"]
print(f"SFT examples: {lf['examples']}")
print(f"dataset:      {lf['dataset']}")
print(f"train:        {lf['train_command']}")
PY
    ;;
  *)  # analytics — the grounded values, in practice
    "$PY" - "$OUT" "$RUNS" <<'PY'
import json, sys
from collections import Counter
out, runs = sys.argv[1], sys.argv[2]
eps = [json.loads(l) for l in open(f"{out}/episodes.jsonl")]
rep = json.load(open(f"{out}/report.json"))
n = len(eps)
cost = sum(e["outcome"].get("costUsd", 0) for e in eps)
tc = sum(e["outcome"].get("toolCalls", 0) for e in eps)
te = sum(e["outcome"].get("toolErrors", 0) for e in eps)
st = Counter(e["outcome"]["status"] for e in eps)
tp = Counter(str(e["outcome"]["testsPassed"]) for e in eps)
imit = sum(1 for e in eps if e["labels"].get("shouldImitate"))
ps = [e["labels"]["processScore"] for e in eps]
avg = lambda x: sum(x) / len(x) if x else 0
bar = "─" * 60
print(bar)
print(f" mini-ork ⟶ TraceOtter   ({n} run trajectories distilled)")
print(bar)
print(f" real cost         ${cost:,.2f}   (mean ${cost/n if n else 0:.3f}/run)")
print(f" tool reliability  {100*(1-te/tc) if tc else 0:.1f}%  ({tc:,} calls, {te:,} errors)")
print(f" outcome           completed {st.get('completed',0)} · partial {st.get('partial',0)} · failed {st.get('failed',0)}")
print(f" tests (parsed)    passed {tp.get('True',0)} · failed {tp.get('False',0)} · none {tp.get('None',0)}")
print(f" process_score     mean {avg(ps):.3f}  (grounded: tool-reliability + grounding + no-fail)")
print(bar)
print(f" distilled skills  {rep['skills']}")
print(f" SFT-ready         {rep['llamafactory']['examples']} examples  (→ train a local lane)")
print(f" clean-imitate     {imit}  (would-imitate: clean completions worth training on)")
print(bar)
print(" next:  mini-ork traceotter skills   |   mini-ork traceotter dataset")
print(f" data:  {out}/  (episodes, skills, quality report, llamafactory/)")
PY
    ;;
esac
