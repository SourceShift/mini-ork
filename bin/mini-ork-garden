#!/usr/bin/env bash
# mini-ork-garden — drift detection with concrete Fix: hints.
#
# Mirrors wshobson/agents' `make garden` discipline: scans for stale runs,
# orphaned worktrees, output-path collisions, missing env-var docs, and
# oversize recipe prompts. Every finding ships a remediation command.

set -Eeuo pipefail

# Source the single path-resolution contract before anything else.
# shellcheck source=lib/paths.sh
. "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)/lib/paths.sh"

ERRORS=0
WARNINGS=0
INFOS=0

_error() {
  echo "[error]   $1" >&2
  echo "          Fix: $2" >&2
  ERRORS=$((ERRORS + 1))
}

_warn() {
  echo "[warning] $1" >&2
  echo "          Fix: $2" >&2
  WARNINGS=$((WARNINGS + 1))
}

_info() {
  echo "[info]    $1" >&2
  echo "          Fix: $2" >&2
  INFOS=$((INFOS + 1))
}

_usage() {
  cat <<'EOF'
Usage: mini-ork garden [--strict]

Drift detection. Every finding includes a concrete Fix: hint.

Options:
  --strict    Exit nonzero on warnings too.
  --help      Show this help.
EOF
}

STRICT=0

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) _usage; exit 0 ;;
    --strict) STRICT=1; shift ;;
    -*)
      echo "Unknown flag: $1" >&2
      _usage >&2
      exit 2
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      _usage >&2
      exit 2
      ;;
  esac
done

# ── 1. Output-path collisions across recipes ──────────────────────────────────
# Build a map of output path -> recipes that publish to it.
_collision_map=$(python3 - "$MINI_ORK_ROOT" <<'PY'
import os, sys, yaml
from collections import defaultdict
root = sys.argv[1]
collisions = defaultdict(list)
recipes_dir = os.path.join(root, "recipes")
if not os.path.isdir(recipes_dir):
    sys.exit(0)
for recipe in sorted(os.listdir(recipes_dir)):
    ac = os.path.join(recipes_dir, recipe, "artifact_contract.yaml")
    if not os.path.isfile(ac):
        continue
    try:
        with open(ac) as f:
            data = yaml.safe_load(f) or {}
    except Exception:
        continue
    for out in data.get("outputs") or []:
        path = out.get("path") if isinstance(out, dict) else out
        # Run-dir internal paths are intentionally shared; only flag target-repo paths.
        if isinstance(path, str) and not path.startswith("${MINI_ORK_RUN_DIR}"):
            collisions[path].append(recipe)
for out, recipes in sorted(collisions.items()):
    if len(recipes) > 1:
        print(f"{out}\t{','.join(recipes)}")
PY
)
if [ -n "$_collision_map" ]; then
  while IFS=$'\t' read -r path recipes; do
    [ -n "$path" ] || continue
    _error "output collision: '$path' used by $recipes" \
      "use recipe-specific output paths in artifact_contract.yaml"
  done <<< "$_collision_map"
fi

# ── 2. Oversize recipe prompts / workflows ────────────────────────────────────
MAX_PROMPT_KB=32
MAX_WORKFLOW_KB=16
while IFS= read -r -d '' f; do
  size_kb=$(($(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0) / 1024))
  if [ "$size_kb" -gt "$MAX_PROMPT_KB" ]; then
    _warn "recipe prompt exceeds ${MAX_PROMPT_KB} KiB: $f (${size_kb} KiB)" \
      "split detail into recipes/<name>/prompts/references/"
  fi
done < <(find "$MINI_ORK_ROOT/recipes" -type f -name '*.md' -print0 2>/dev/null || true)

while IFS= read -r -d '' f; do
  size_kb=$(($(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0) / 1024))
  if [ "$size_kb" -gt "$MAX_WORKFLOW_KB" ]; then
    _warn "recipe workflow exceeds ${MAX_WORKFLOW_KB} KiB: $f (${size_kb} KiB)" \
      "decompose into smaller nodes or move detail to references/"
  fi
done < <(find "$MINI_ORK_ROOT/recipes" -type f -name 'workflow.yaml' -print0 2>/dev/null || true)

# ── 3. Stale runs directories ─────────────────────────────────────────────────
RUNS_DIR="$MINI_ORK_HOME/runs"
if [ -d "$RUNS_DIR" ]; then
  # Find run dirs older than 30 days with no recent activity.
  while IFS= read -r -d '' run_dir; do
    _info "run directory older than 30 days: $run_dir" \
      "archive or remove with 'rm -rf $run_dir'"
  done < <(find "$RUNS_DIR" -maxdepth 1 -type d -mtime +30 -print0 2>/dev/null || true)
fi

# ── 4. Orphaned wip-pre-implementer worktrees/stashes ─────────────────────────
if command -v git >/dev/null 2>&1; then
  git -C "$MINI_ORK_TARGET_REPO" stash list 2>/dev/null | grep -E '^stash@\{[0-9]+\}: wip-pre-implementer' | while read -r line; do
    _warn "orphaned implementer stash in target repo: $line" \
      "review and drop with 'git stash drop <stash>'"
  done || true
fi

# ── 5. env-var docs drift ─────────────────────────────────────────────────────
# Collect env vars referenced in lib/ and bin/ and check they're documented.
_env_vars=$(grep -RoE '\bMO_[A-Z_]+\b|\bMINI_ORK_[A-Z_]+\b' "$MINI_ORK_ROOT/lib" "$MINI_ORK_ROOT/bin" 2>/dev/null \
  | cut -d: -f2 | sort -u | grep -vE '^(MINI_ORK_ROOT|MINI_ORK_HOME|MINI_ORK_DB|MINI_ORK_RUN_ID|MINI_ORK_RECIPE|MINI_ORK_WORKFLOW|MINI_ORK_TASK_CLASS|MINI_ORK_PROFILE_PATH|MINI_ORK_TARGET_REPO|MINI_ORK_ENGINE_ROOT|MINI_ORK_PROJECT_HOME)$' || true)
if [ -n "$_env_vars" ]; then
  env_doc="$MINI_ORK_ROOT/docs/operator/env-vars.md"
  if [ ! -f "$env_doc" ]; then
    _warn "env-var documentation missing: $env_doc" "create $env_doc documenting env vars"
  fi
fi

# ── summary ───────────────────────────────────────────────────────────────────
if [ "$ERRORS" -gt 0 ]; then
  echo "garden: $ERRORS error(s), $WARNINGS warning(s), $INFOS info" >&2
  exit 1
fi
if [ "$STRICT" -eq 1 ] && [ "$WARNINGS" -gt 0 ]; then
  echo "garden: $ERRORS error(s), $WARNINGS warning(s), $INFOS info (strict mode)" >&2
  exit 1
fi
if [ "$WARNINGS" -gt 0 ] || [ "$INFOS" -gt 0 ]; then
  echo "garden: $ERRORS error(s), $WARNINGS warning(s), $INFOS info" >&2
  exit 0
fi
echo "garden: clean"
