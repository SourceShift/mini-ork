#!/usr/bin/env bash
# mini-ork-validate — pre-run static checks with concrete Fix: hints.
#
# Mirrors wshobson/agents' `make validate` discipline: every finding ships a
# remediation command. Exit 0 if no errors; exit 1 if errors found.

set -Eeuo pipefail

# Source the single path-resolution contract before anything else.
# shellcheck source=lib/paths.sh
. "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)/lib/paths.sh"

ERRORS=0
WARNINGS=0

_error() {
  echo "[error]   $1" >&2
  echo "          Fix: $2" >&2
  ERRORS=$((ERRORS + 1))
}

_warn() {
  echo "[warning] $1" >&2
  echo "          Fix: $2" >&2
  WARNINGS=$((WARNINGS + 1))
}

_usage() {
  cat <<'EOF'
Usage: mini-ork validate [kickoff.md] [--recipe <name>]

Pre-run static checks. Every finding includes a concrete Fix: hint.

Options:
  --recipe <name>   Validate a specific recipe instead of inferring from kickoff.
  --strict          Treat warnings as errors.
  --help            Show this help.
EOF
}

KICKOFF=""
RECIPE=""
STRICT=0

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) _usage; exit 0 ;;
    --strict) STRICT=1; shift ;;
    --recipe) RECIPE="$2"; shift 2 ;;
    -*)
      echo "Unknown flag: $1" >&2
      _usage >&2
      exit 2
      ;;
    *)
      if [ -z "$KICKOFF" ]; then
        KICKOFF="$1"; shift
      else
        echo "Unexpected argument: $1" >&2
        _usage >&2
        exit 2
      fi
      ;;
  esac
done

# ── recipe resolution ─────────────────────────────────────────────────────────
if [ -n "$KICKOFF" ] && [ -z "$RECIPE" ]; then
  if [ -f "$KICKOFF" ]; then
    RECIPE=$(MINI_ORK_DRY_RUN=1 PYTHONPATH="${MINI_ORK_ROOT}${PYTHONPATH:+:$PYTHONPATH}" \
      python3 -m mini_ork.ported.mini_ork_classify "$KICKOFF" 2>/dev/null \
      | grep -E '^task_class=' | head -1 | cut -d= -f2 | tr '_' '-' || true)
  fi
fi

# ── 1. Kickoff checks ─────────────────────────────────────────────────────────
if [ -n "$KICKOFF" ] && [ -f "$KICKOFF" ]; then
  if ! grep -qiE '^#{1,6}\s*(Goal|Done[- ]When|Definition of Done|Acceptance)' "$KICKOFF"; then
    _warn "kickoff $KICKOFF has no recognizable Goal/Done-When heading" \
      "add a '## Goal' and '## Done When' section to $KICKOFF"
  fi

  size_bytes=$(stat -f%z "$KICKOFF" 2>/dev/null || stat -c%s "$KICKOFF" 2>/dev/null || echo 0)
  max_bytes="${MO_MAX_KICKOFF_BYTES:-1048576}"
  if [ "$size_bytes" -gt "$max_bytes" ]; then
    _error "kickoff $KICKOFF is ${size_bytes} bytes (cap: ${max_bytes})" \
      "split into single-deliverable kickoffs; move detail to kickoffs/references/"
  fi
fi

# ── 2. Recipe manifest schema checks ──────────────────────────────────────────
if [ -n "$RECIPE" ] && [ -d "$MINI_ORK_ROOT/recipes/$RECIPE" ]; then
  recipe_dir="$MINI_ORK_ROOT/recipes/$RECIPE"
  for req in task_class.yaml workflow.yaml artifact_contract.yaml; do
    if [ ! -f "$recipe_dir/$req" ]; then
      _error "recipe $RECIPE missing $req" "create $recipe_dir/$req from the recipe template"
    fi
  done

  # workflow.yaml: basic structural sanity
  wf="$recipe_dir/workflow.yaml"
  if [ -f "$wf" ]; then
    if ! python3 -c 'import yaml,sys; yaml.safe_load(open(sys.argv[1]))' "$wf" 2>/dev/null; then
      _error "recipe $RECIPE workflow.yaml is not valid YAML" "fix YAML syntax in $wf"
    fi
  fi

  # artifact_contract.yaml: output-path collision guard
  ac="$recipe_dir/artifact_contract.yaml"
  if [ -f "$ac" ]; then
    outputs=$(python3 - "$ac" <<'PY' 2>/dev/null
import yaml, sys
with open(sys.argv[1]) as f:
    data = yaml.safe_load(f) or {}
for o in data.get("outputs") or []:
    path = o.get("path") if isinstance(o, dict) else o
    if isinstance(path, str):
        print(path)
PY
)
    if [ -n "$outputs" ]; then
      while IFS= read -r out; do
        [ -n "$out" ] || continue
        # Run-dir internal paths are intentionally shared.
        case "$out" in
          '\${MINI_ORK_RUN_DIR}'*) continue ;;
        esac
        # Count how many other recipes target the same path.
        collisions=$(grep -lRxF "outputs:" "$MINI_ORK_ROOT/recipes" 2>/dev/null \
          | xargs grep -lF "$out" 2>/dev/null | wc -l | tr -d ' ')
        if [ "$collisions" -gt 1 ]; then
          _warn "recipe $RECIPE output path '$out' is also targeted by $((collisions - 1)) other recipe(s)" \
            "use a recipe-specific output path in $ac"
        fi
      done <<< "$outputs"
    fi
  fi
else
  if [ -n "$RECIPE" ]; then
    _error "recipe not found: $RECIPE" "check recipes/ or run 'mini-ork classify $KICKOFF'"
  fi
fi

# ── 3. Active lane profile / capability rules ─────────────────────────────────
agents_yaml=$(python3 - "$MINI_ORK_ROOT" <<'PY' 2>/dev/null
import os, sys
root = sys.argv[1]
# Reproduce config_resolve precedence: MINI_ORK_HOME/config first.
for p in [
    os.path.join(os.environ.get('MINI_ORK_HOME', ''), 'config', 'agents.yaml'),
    os.path.join(root, 'config', 'agents.yaml'),
]:
    if os.path.isfile(p):
        print(p)
        break
PY
)
if [ -n "$agents_yaml" ] && [ -f "$agents_yaml" ]; then
  if ! python3 -c 'import yaml,sys; yaml.safe_load(open(sys.argv[1]))' "$agents_yaml" 2>/dev/null; then
    _error "agents.yaml is not valid YAML: $agents_yaml" "fix YAML syntax"
  fi
else
  _warn "no agents.yaml found in MINI_ORK_HOME/config or ENGINE_ROOT/config" \
    "run 'mini-ork init' to seed default config"
fi

# ── 4. Secrets presence for executable lanes ──────────────────────────────────
providers_yaml="${MINI_ORK_HOME}/config/providers.yaml"
if [ -f "$providers_yaml" ]; then
  missing_secrets=$(python3 - "$providers_yaml" <<'PY' 2>/dev/null
import yaml, sys, os
with open(sys.argv[1]) as f:
    data = yaml.safe_load(f) or {}
for name, cfg in (data.get('providers') or {}).items():
    env_var = cfg.get('api_key_env') or cfg.get('env_key')
    if env_var and not os.environ.get(env_var):
        print(f"{name} -> {env_var}")
PY
)
  if [ -n "$missing_secrets" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      _warn "provider secret missing: $line" "set it in $MINI_ORK_HOME/config/secrets.local.sh"
    done <<< "$missing_secrets"
  fi
fi

# ── summary ───────────────────────────────────────────────────────────────────
if [ "$ERRORS" -gt 0 ]; then
  echo "validate: $ERRORS error(s), $WARNINGS warning(s)" >&2
  exit 1
fi
if [ "$STRICT" -eq 1 ] && [ "$WARNINGS" -gt 0 ]; then
  echo "validate: $ERRORS error(s), $WARNINGS warning(s) (strict mode)" >&2
  exit 1
fi
if [ "$WARNINGS" -gt 0 ]; then
  echo "validate: $ERRORS error(s), $WARNINGS warning(s)" >&2
  exit 0
fi
echo "validate: OK"
