#!/usr/bin/env python3
"""Launcher for ``mini-ork triage`` — failure attribution + opt-in fix queue.

Imports the handler directly so the command works from the engine tree today.
Once ``"triage": "mini_ork.cli.triage"`` is added to ``_NATIVE_MODULE_SUBS`` in
``mini_ork/cli/main.py``, this file collapses to the standard shim
(``from _mini_ork_subcommand import main; main("triage")``) — the same shape as
``bin/mini-ork-bugs``. The direct import is what keeps the command usable until
that one-line registration lands (it was deferred: ``main.py`` is claimed by a
live worktree).

The venv re-exec mirrors ``bin/mini-ork``: a linked worktree has no ``.venv``
of its own, so we redirect to the MAIN checkout's runtime python (via the
worktree→main mapping) and otherwise refuse to run below ``requires-python``.
That matters here specifically: on 3.9 a recipe verifier crashes at import with
``unsupported operand type(s) for |`` — the very class of failure this command
exists to attribute — so running triage itself on 3.9 would be self-defeating.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MIN_PYTHON = (3, 11)


def _unresolved(value: str, root: Path) -> Path:
    path = Path(value).expanduser()
    if not path.is_absolute():
        path = root / path
    return Path(os.path.normpath(str(path)))


def _main_checkout_equivalent(root: Path) -> Path | None:
    """``root``'s counterpart in the MAIN checkout when it is a linked worktree."""
    for top in (root, *root.parents):
        dotgit = top / ".git"
        if dotgit.is_dir():
            return None
        if not dotgit.is_file():
            continue
        try:
            line = dotgit.read_text(encoding="utf-8").strip()
        except OSError:
            return None
        if not line.startswith("gitdir:"):
            return None
        gitdir = _unresolved(line[len("gitdir:"):].strip(), top)
        if gitdir.parent.name != "worktrees" or gitdir.parent.parent.name != ".git":
            return None
        try:
            rel = root.relative_to(top)
        except ValueError:
            return None
        return gitdir.parent.parent.parent / rel
    return None


def _venv_python_at(root: Path) -> Path | None:
    pointer = root / ".mini-ork" / "runtime-python"
    if pointer.is_file():
        try:
            lines = pointer.read_text(encoding="utf-8").splitlines()
            if lines and lines[0].strip():
                return _unresolved(lines[0].strip(), root)
        except OSError:
            pass
    python = root / ".venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
    return python if python.is_file() else None


def _venv_python(root: Path) -> Path | None:
    if configured := os.environ.get("MINI_ORK_VENV"):
        return _unresolved(configured, root) / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
    found = _venv_python_at(root)
    if found is not None:
        return found
    main = _main_checkout_equivalent(root)
    return _venv_python_at(main) if main is not None else None


def _reexec_in_project_venv() -> None:
    if os.environ.get("MINI_ORK_TRIAGE_VENV_ACTIVE") == "1":
        return
    if sys.version_info >= MIN_PYTHON:
        return
    python = _venv_python(ROOT)
    if python is None or not python.is_file():
        return
    environment = dict(os.environ)
    environment["MINI_ORK_TRIAGE_VENV_ACTIVE"] = "1"
    os.execve(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]], environment)


_reexec_in_project_venv()

if sys.version_info < MIN_PYTHON:
    want = ".".join(map(str, MIN_PYTHON))
    sys.stderr.write(
        f"mini-ork triage: Python {want}+ is required, but this is "
        f"{sys.version.split()[0]} ({sys.executable}).\n"
        f"  No project venv found for {ROOT}.\n"
        f"  Fix: run `make install` there, or set MINI_ORK_VENV=<venv dir>.\n"
    )
    raise SystemExit(2)

sys.path.insert(0, str(ROOT))
os.environ.setdefault("MINI_ORK_ROOT", str(ROOT))

from mini_ork.cli.triage import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:], root=str(ROOT)))
