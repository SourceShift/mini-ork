#!/usr/bin/env bash
# bin/mini-ork-usage-report
# Emit a per-actor/lens token-usage report for a completed mini-ork run.
# Writes $RUN_DIR/usage.json aggregating llm_calls rows for the run.
#
# Usage:
#   MINI_ORK_RUN_DIR=<run-dir> [MINI_ORK_DB=<db>] mini-ork-usage-report
# or
#   mini-ork-usage-report <run-dir> [<db>]

set -euo pipefail

MINI_ORK_ROOT="${MINI_ORK_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

RUN_DIR="${1:-${MINI_ORK_RUN_DIR:-}}"
DB="${2:-${MINI_ORK_DB:-${MINI_ORK_HOME:-.mini-ork}/state.db}}"

if [ -z "$RUN_DIR" ]; then
  echo "usage: mini-ork-usage-report <run-dir> [<db>]" >&2
  echo "   or: MINI_ORK_RUN_DIR=<run-dir> mini-ork-usage-report" >&2
  exit 2
fi

if [ ! -d "$RUN_DIR" ]; then
  echo "mini-ork-usage-report: run dir not found: $RUN_DIR" >&2
  exit 2
fi

if [ ! -f "$DB" ]; then
  echo "mini-ork-usage-report: db not found: $DB" >&2
  exit 2
fi

# run_id is the directory name (matches MINI_ORK_RUN_ID convention)
RUN_ID="$(basename "$RUN_DIR")"
OUT="$RUN_DIR/usage.json"

python3 - "$DB" "$RUN_ID" "$OUT" <<'PY'
import json, sqlite3, sys

def main():
    db_path, run_id, out_path = sys.argv[1:4]
    con = sqlite3.connect(db_path)
    con.row_factory = sqlite3.Row

    # Aggregate per actor (lens/node). actor is the most specific agent identity;
    # feature_name + model_id + provider give additional detail.
    rows = con.execute(
        """
        SELECT
            COALESCE(NULLIF(actor, ''), 'unknown') AS actor,
            COALESCE(NULLIF(feature_name, ''), 'unknown') AS feature_name,
            COALESCE(NULLIF(model_id, ''), 'unknown') AS model_id,
            COALESCE(NULLIF(provider, ''), 'unknown') AS provider,
            COALESCE(NULLIF(tier, ''), 'default') AS tier,
            SUM(input_tokens) AS input_tokens,
            SUM(output_tokens) AS output_tokens,
            SUM(total_tokens) AS total_tokens,
            SUM(cost_usd) AS cost_usd,
            SUM(duration_ms) AS duration_ms,
            COUNT(*) AS calls
        FROM llm_calls
        WHERE run_id = ?
        GROUP BY actor, feature_name, model_id, provider, tier
        ORDER BY total_tokens DESC
        """,
        (run_id,),
    ).fetchall()

    entries = []
    for r in rows:
        entries.append({
            "actor": r["actor"],
            "feature_name": r["feature_name"],
            "model_id": r["model_id"],
            "provider": r["provider"],
            "tier": r["tier"],
            "input_tokens": int(r["input_tokens"] or 0),
            "output_tokens": int(r["output_tokens"] or 0),
            "total_tokens": int(r["total_tokens"] or 0),
            "cost_usd": float(r["cost_usd"] or 0.0),
            "duration_ms": int(r["duration_ms"] or 0),
            "calls": int(r["calls"] or 0),
        })

    totals = {
        "input_tokens": sum(e["input_tokens"] for e in entries),
        "output_tokens": sum(e["output_tokens"] for e in entries),
        "total_tokens": sum(e["total_tokens"] for e in entries),
        "cost_usd": round(sum(e["cost_usd"] for e in entries), 8),
        "duration_ms": sum(e["duration_ms"] for e in entries),
        "calls": sum(e["calls"] for e in entries),
    }

    payload = {
        "run_id": run_id,
        "generated_at": __import__('datetime').datetime.utcnow().isoformat() + "Z",
        "totals": totals,
        "agents": entries,
    }

    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2, sort_keys=True)
        f.write("\n")

    print(f"mini-ork-usage-report: wrote {len(entries)} agent entries to {out_path}")

if __name__ == "__main__":
    main()
PY
