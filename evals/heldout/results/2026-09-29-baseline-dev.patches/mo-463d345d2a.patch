+def _identity_env(worktree: str) -> dict[str, str]:
+    """Fallback git identity for the mutating `git merge --no-edit` that lands
+    the product branch on the deploy target. Without one, CI / fresh-container
+    runners die with `empty ident name ... not allowed`, and the resync is
+    mis-reported as a merge conflict — which is exactly the regression this
+    binding exists to prevent.
+
+    Configured identity wins; an explicitly empty `GIT_*` env is filled too —
+    that empty-variable case is what CI actually presents (CI exports the
+    keys with empty strings rather than unset). Identity matches
+    `mini_ork/vcs/rebase_guard.py` and `mini_ork/vcs/auto_merge.py`
+    (`mini-ork` / `mini-ork@localhost`). Only applied to the merge call —
+    other git invocations inherit the ambient env."""
+    e = dict(os.environ)
+    # A configured (non-empty) env pair wins — leave the env alone.
+    if e.get("GIT_AUTHOR_EMAIL") and e.get("GIT_COMMITTER_EMAIL"):
+        return e
+    # Otherwise check git config; if empty (or blocked to /dev/null by the
+    # test that reproduces CI's failure), fill the fallback identity —
+    # including empty env values, since `setdefault` would leave "" in place.
+    cfg = subprocess.run(
+        ["git", "-C", worktree, "config", "user.email"],
+        capture_output=True, text=True,
+    ).stdout.strip()
+    if not cfg:
+        for key, val in (
+            ("GIT_AUTHOR_NAME", "mini-ork"),
+            ("GIT_AUTHOR_EMAIL", "mini-ork@localhost"),
+            ("GIT_COMMITTER_NAME", "mini-ork"),
+            ("GIT_COMMITTER_EMAIL", "mini-ork@localhost"),
+        ):
+            if not e.get(key):
+                e[key] = val
+    return e
+
+
