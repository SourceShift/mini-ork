+def _stub_q(monkeypatch, stdout: str, returncode: int = 0):
+    """Replace ``_tfmod._q`` with a stub returning a fixed CompletedProcess.
+
+    The real ``_q`` shells out to psql; tests want hermetic control of the
+    chapter row without any DB. The stdout mimics the SQL projection
+    ``status|committed_complete|permanently_failed|last_error``.
+    """
+    monkeypatch.setattr(
+        _tfmod,
+        "_q",
+        lambda sql: subprocess.CompletedProcess(
+            args=["psql"], returncode=returncode, stdout=stdout, stderr="",
+        ),
+    )
+
+
+def test_terminal_fail_worker_exhausted_idle_is_terminal(tmp_path, monkeypatch):
+    """status=failed + last_error + stale run-dir ⇒ TERMINAL (worker exhausted retries).
+
+    This is the dominant stall mode observed on live book d0df3cdb: the worker
+    burns its per-dispatch retry budget, lands on status=failed (NOT
+    permanently_failed), and goes idle. Without this branch the await sat out
+    the full 90-min MO_GOAL_APPLY_AWAIT_SECONDS window on a chapter only a
+    redispatch could advance.
+    """
+    import time as _t
+
+    runs = tmp_path / "runs"
+    runs.mkdir()
+    # Stamp an OLD run-* dir so age >= MO_GOAL_STALL_SECONDS (worker is idle).
+    (runs / "run-000").mkdir()
+    stale = _t.time() - 4000
+    os.utime(runs / "run-000", (stale, stale))
+
+    monkeypatch.setenv("BOOK_UUID", "d0df3cdb-8164-450e-b841-2c9354ea0423")
+    monkeypatch.setenv("MO_GOAL_RUNS_DIR", str(runs))
+    monkeypatch.setenv("MO_GOAL_STALL_SECONDS", "60")
+    # permfail=f so the "always terminal" gate does not preempt the stall gate.
+    _stub_q(monkeypatch, "failed|f|f|retry budget exhausted\n")
+
+    assert _tfmod.main(["1"]) == 0
+
+
+def test_terminal_fail_failed_but_churning_not_terminal(tmp_path, monkeypatch):
+    """status=failed + last_error + FRESH run-dir ⇒ NOT terminal (still churning).
+
+    A chapter can racily fail BETWEEN retries while the worker is alive and
+    mid-cycle; the run-dir mtime stays fresh because the worker just emitted
+    a verified artifact. Treating that as terminal would abandon a recoverable
+    chapter — strictly more aggressive than MO_GOAL_FAIL_ON_STATUS_FAILED and
+    unsafe. The idle-run-dir gate is what keeps the broadened status set from
+    regressing into a fail-fast on transient failures.
+    """
+    runs = tmp_path / "runs"
+    runs.mkdir()
+    # A fresh run-* dir ⇒ age is small (< MO_GOAL_STALL_SECONDS) ⇒ churning.
+    (runs / "run-001").mkdir()
+
+    monkeypatch.setenv("BOOK_UUID", "d0df3cdb-8164-450e-b841-2c9354ea0423")
+    monkeypatch.setenv("MO_GOAL_RUNS_DIR", str(runs))
+    monkeypatch.setenv("MO_GOAL_STALL_SECONDS", "60")
+    _stub_q(monkeypatch, "failed|f|f|transient retry failure\n")
+
+    assert _tfmod.main(["1"]) == 1
+
+
+def test_terminal_fail_permfail_always_terminal(monkeypatch):
+    """permanently_failed=t wins regardless of status / run-dir / stall env.
+
+    The researcher's own give-up flag is the unambiguous terminal signal; the
+    broadened stall branch must never preempt it.
+    monkeypatch.delenv is used because MO_GOAL_RUNS_DIR unset is the default
+    — making sure permfail fires WITHOUT the stall env armed.
+    """
+    monkeypatch.setenv("BOOK_UUID", "d0df3cdb-8164-450e-b841-2c9354ea0423")
+    monkeypatch.delenv("MO_GOAL_RUNS_DIR", raising=False)
+    monkeypatch.delenv("MO_GOAL_STALL_SECONDS", raising=False)
+    _stub_q(monkeypatch, "error|f|t|researcher gave up\n")
+
+    assert _tfmod.main(["1"]) == 0
+
+
