diff --git a/tests/unit/test_mini_ork_self_improve_py.py b/tests/unit/test_mini_ork_self_improve_py.py
index 8ae2096d..41ffdb71 100644
--- a/tests/unit/test_mini_ork_self_improve_py.py
+++ b/tests/unit/test_mini_ork_self_improve_py.py
@@ -115,3 +115,51 @@ def test_record_success(tmp_path):
     assert "old|1|meta|old row|superseded" in got
     # the new resolved row references the iteration's branch
     assert "run-7|3|" in got and "resolved" in got
+
+
+# ── surface-scoped leak guard ──
+
+def test_restore_root_surface_leak(tmp_path):
+    """Surface-scoped leak guard: only paths clean pre-run AND inside the
+    improvable surface get reverted. Operator pre-dirty WIP and out-of-
+    surface changes are untouched.
+    """
+    # Build a tiny mini-ork-shaped repo: git init, surface dirs, an outside
+    # file, an operator WIP. Commit baseline so `git status` is meaningful.
+    repo = tmp_path / "repo"; repo.mkdir()
+    subprocess.run(["git", "init", "-q", str(repo)], check=True)
+    subprocess.run(["git", "-C", str(repo), "config", "user.email", "t@t"], check=True)
+    subprocess.run(["git", "-C", str(repo), "config", "user.name", "t"], check=True)
+    for d in ("mini_ork", "recipes", "schemas", "tests", "docs"):
+        (repo / d).mkdir()
+    (repo / "mini_ork" / "a.py").write_text("# baseline a\n")
+    (repo / "recipes" / "r.yaml").write_text("# baseline r\n")
+    (repo / "tests" / "t.py").write_text("# baseline t\n")
+    (repo / "docs" / "notes.md").write_text("# baseline docs\n")
+    subprocess.run(["git", "-C", str(repo), "add", "-A"], check=True)
+    subprocess.run(["git", "-C", str(repo), "commit", "-q", "-m", "baseline"], check=True)
+
+    # Operator WIP — already dirty pre-run; MUST NOT be reverted.
+    (repo / "mini_ork" / "wip.py").write_text("# operator WIP\n")
+
+    # Snapshot pre-dispatch state (must include the WIP).
+    pre = si._root_surface_dirty(str(repo))
+    assert "mini_ork/wip.py" in pre
+
+    # Simulate three leaks during the iter:
+    # 1. tracked mutation inside surface (a.py modified)
+    (repo / "mini_ork" / "a.py").write_text("# LEAK: iter mutated a\n")
+    # 2. untracked file inside surface (new b.py)
+    (repo / "mini_ork" / "b.py").write_text("# LEAK: iter dropped b\n")
+    # 3. out-of-surface operator edit (docs/notes.md) — must NOT be reverted.
+    (repo / "docs" / "notes.md").write_text("# out-of-surface operator edit\n")
+
+    # Run the leak guard.
+    reverted = si._restore_root_surface_leak(str(repo), pre)
+
+    # The two in-surface leaks are reverted; WIP + out-of-surface untouched.
+    assert reverted == ["mini_ork/a.py", "mini_ork/b.py"]
+    assert (repo / "mini_ork" / "a.py").read_text() == "# baseline a\n"
+    assert not (repo / "mini_ork" / "b.py").exists()
+    assert (repo / "mini_ork" / "wip.py").read_text() == "# operator WIP\n"
+    assert (repo / "docs" / "notes.md").read_text() == "# out-of-surface operator edit\n"
