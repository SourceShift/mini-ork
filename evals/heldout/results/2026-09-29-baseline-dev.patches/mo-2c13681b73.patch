+# ── surface-scoped leak guard ──────────────────────────────────────────
+# The self-improve iter dispatches into a linked worktree under
+# home/worktrees/iter-N-ts. When path resolution mis-targets the parent
+# checkout, the implementer's edits leak into root instead of staying in
+# the worktree, so a rejected iteration has been observed leaving modified
+# tracked files and stray untracked files in main (iter-1 leaked verify.py
+# + test_verify.py and had to be hand-reverted). The guard below snapshots
+# the surface as it stood BEFORE dispatch, then after the iter is decided
+# (and ONLY on non-success outcomes — a successful auto_merge intentionally
+# modifies root, so reverting there would erase the very change we wanted
+# to land) reverts only paths that went clean→dirty during the run. Paths
+# the operator already had dirty are never touched, so a concurrent
+# hand-edit on a self-improve iter is the operator's choice, not a leak.
+
+_ROOT_SURFACE_DIRS = ("mini_ork", "recipes", "schemas", "tests")
+
+
+def _root_surface_dirty(root: str) -> set:
+    """NUL-delimited `git status --porcelain` over the improvable surface.
+
+    Returns the set of repo-relative paths currently dirty inside
+    mini_ork/, recipes/, schemas/, tests/. Mirrors the recursive-self-
+    improve kickoff's "Improvable surface" wording exactly, so the snapshot
+    is exactly the paths a leak guard can revert safely. Out-of-surface
+    edits (operator WIP under docs/, scratch under .mini-ork/) are
+    intentionally invisible — they can't be leaked by an iter, so they
+    don't belong in the snapshot.
+    """
+    rel = subprocess.run(
+        ["git", "-C", root, "status", "--porcelain", "-z",
+         "--", *_ROOT_SURFACE_DIRS],
+        capture_output=True,
+    )
+    if rel.returncode != 0 or not rel.stdout:
+        return set()
+    parts = rel.stdout.decode("utf-8", errors="replace").split("\x00")
+    dirty: set = set()
+    i = 0
+    while i < len(parts):
+        entry = parts[i]
+        i += 1
+        if not entry or len(entry) < 4 or entry[2] != " ":
+            continue
+        path = entry[3:]
+        # In -z mode, rename/copy entries report "<XY> <orig>\0<new>"; the
+        # next non-empty part is the destination. For everything else, the
+        # path is everything after "XY ".
+        if entry[1] in ("R", "C") and i < len(parts) and parts[i]:
+            path = parts[i]
+            i += 1
+        path = path.strip()
+        if path.startswith('"') and path.endswith('"'):
+            path = path[1:-1].replace('\\"', '"').replace('\\\\', '\\')
+        if path:
+            dirty.add(path)
+    return dirty
+
+
+def _restore_root_surface_leak(root: str, pre_dirty: set) -> list:
+    """Revert in-surface leaks: paths that were clean at snapshot time but
+    became dirty during the run.
+
+    Tracked paths → `git checkout HEAD -- <path>` (in-surface only).
+    Untracked files → `os.remove` (only the file itself, never a dir).
+
+    Paths the operator already had dirty pre-run (`pre_dirty`) are NEVER
+    touched — a concurrent hand-edit on a self-improve iter is the
+    operator's choice, not a leak. Out-of-surface paths are invisible to
+    this function (the snapshot never included them).
+
+    Returns the sorted list of paths that were reverted, for logging.
+    """
+    post = _root_surface_dirty(root)
+    leaked = post - pre_dirty
+    if not leaked:
+        return []
+    reverted: list = []
+    for path in sorted(leaked):
+        # Defense in depth — the snapshot is bounded by _ROOT_SURFACE_DIRS,
+        # so a path here is by construction inside the surface, but reject
+        # anything that slipped through (e.g. an absolute path or a `..`).
+        if not any(path == d or path.startswith(d + "/") for d in _ROOT_SURFACE_DIRS):
+            continue
+        abs_path = os.path.join(root, path)
+        if not os.path.exists(abs_path):
+            continue
+        is_tracked = subprocess.run(
+            ["git", "-C", root, "ls-files", "--error-unmatch", "--", path],
+            capture_output=True,
+        ).returncode == 0
+        ok = False
+        if is_tracked:
+            ok = subprocess.run(
+                ["git", "-C", root, "checkout", "HEAD", "--", path],
+                capture_output=True,
+            ).returncode == 0
+        else:
+            # Untracked single files only — never rm -r. An untracked dir
+            # left by the iter is rare and the conservative choice is to
+            # leave it for the operator to clean up; the leak guard's job
+            # is to revert the obvious case, not to delete directories.
+            if os.path.isfile(abs_path):
+                try:
+                    os.remove(abs_path)
+                    ok = True
+                except OSError:
+                    ok = False
+        if ok:
+            reverted.append(path)
+    return reverted
+
+
 def main(argv=None, *, root=None, dispatch=None) -> int:
     argv = list(sys.argv[1:] if argv is None else argv)
     root = root or os.environ.get("MINI_ORK_ROOT") or os.path.dirname(
