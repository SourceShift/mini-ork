+            "VALUES (?, ?, 'main', 'sha', 'glm')",
+            (epic, f"run-rv-{i}"),
+        )
+        run_ids.append(con.execute("SELECT last_insert_rowid()").fetchone()[0])
+    con.commit()
+    con.close()
+    return run_ids
