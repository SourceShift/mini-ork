+def test_reflection_verify_patterns_gate(temp_db):
+    """Judge-gate promotes only evidence-backed 'proposed' rows to 'approved'.
+
+    Seeds REAL execution_traces rows with distinct run_ids so the independence-
+    aware evidence counter has something to resolve. Floor (defaults):
+    strength_score >= 3 AND distinct-run count >= 3 (safety floor clamps UP).
+    Rows below either bound stay 'proposed'.
+    """
+    r0, r1, r2, r3 = _seed_runs(temp_db, 4)
+    _seed_execution_traces(temp_db, {
+        "t-strong": r0,
+        "t-weak": r1,
+        "t-no-ev": r2,   # seeded but the pattern has no members referencing it
+        "t-already": r3,
+    })
+    seed = [
+        # 1 distinct run behind 3 member ids (t-strong repeated 3x in JSON).
+        ("p-strong",   [{"item_table": "execution_traces", "item_id": "t-strong"}] * 3,
+         5.0, "proposed"),  # fail: only 1 distinct run (clamped floor=3)
+        ("p-weak-str", [{"item_table": "execution_traces", "item_id": "t-weak"}], 2.0, "proposed"),  # fail: strength
+        ("p-no-ev",    [],                                                     9.0, "proposed"),  # fail: no evidence
+        ("p-already",  [{"item_table": "execution_traces", "item_id": "t-already"}], 8.0, "approved"),  # not proposed
+    ]
+
+    _seed_emergent(temp_db, seed)
+    n, emitted = _run_verify()
+    assert n == 0
+    assert emitted == "0"
+
+    statuses = _statuses(temp_db)
+    assert statuses["p-strong"] == "proposed"    # 1 distinct run < floor 3
+    assert statuses["p-weak-str"] == "proposed"  # strength below floor
+    assert statuses["p-no-ev"] == "proposed"     # no members
+    assert statuses["p-already"] == "approved"   # not in scope
+
