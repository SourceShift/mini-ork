+def _count_distinct_runs(con: sqlite3.Connection, members_json: str) -> int:
+    """Independence-aware evidence count behind a member list.
+
+    Counts DISTINCT non-null run_ids behind the named trace ids. Rules:
+      * a repeated trace id is one observation (collapsed before the lookup);
+      * N traces sharing one run_id are one observation (SQL DISTINCT run_id);
+      * a NULL/empty run_id is unproven independence and counts zero
+        (filtered out of the distinct set);
+      * an unresolvable trace id counts zero (no row → no run_id);
+      * a missing execution_traces table falls back to the distinct-id count
+        rather than crashing reflection (cold-schema safety).
+
+    Members are the dicts persisted by `_persist_suggestions_upsert`
+    (``{"item_table": "execution_traces", "item_id": tid}``); non-dict or
+    empty item_id entries contribute zero.
+    """
+    try:
+        members = json.loads(members_json) if members_json else []
+    except (json.JSONDecodeError, TypeError):
+        return 0
+    if not isinstance(members, list):
+        return 0
+    trace_ids: list[str] = []
+    seen: set[str] = set()
+    for m in members:
+        if not isinstance(m, dict):
+            continue
+        tid = m.get("item_id")
+        if not isinstance(tid, str) or not tid:
+            continue
+        if tid in seen:
+            # Repeated trace id collapses to one observation before lookup.
+            continue
+        seen.add(tid)
+        trace_ids.append(tid)
+    if not trace_ids:
+        return 0
+    try:
+        placeholders = ",".join("?" * len(trace_ids))
+        rows = con.execute(
+            f"SELECT DISTINCT run_id FROM execution_traces "
+            f"WHERE trace_id IN ({placeholders})",
+            trace_ids,
+        ).fetchall()
+    except sqlite3.OperationalError:
+        # Missing execution_traces table (cold schema): distinct-id fallback
+        # rather than crashing reflection.
+        return len(seen)
+    run_ids = {
+        r[0] for r in rows
+        if r[0] is not None and r[0] != ""
+    }
+    return len(run_ids)
+
