@@ -0,0 +1,349 @@
+"""Tests for scripts/llm_calls_cost_backfill.py — the retroactive sweep that
+re-prices the cache-aware cost breakdown columns under the new family-keyed
+INPUT_INCLUDES_CACHE + FAMILY_RATES rules.
+
+Hard contract under test:
+  - DRY-RUN BY DEFAULT (no --apply). Without --apply, no DB writes occur.
+  - Never touches input_tokens / output_tokens / cached_input_tokens /
+    cache_creation_input_tokens / cost_usd.
+  - Re-prices historical anthropic / openai / gateway rows under the new
+    semantics — the receipt rows that previously went to $0.0017 (cached >
+    input → clamped to 0) now land at full fresh-only cost.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+
+# Repo root on path so the backfill script (under scripts/) can be invoked
+# as a Python module — mirrors how an operator runs it from the CLI.
+REPO_ROOT = Path(__file__).resolve().parents[2]
+SCRIPT_PATH = REPO_ROOT / "scripts" / "llm_calls_cost_backfill.py"
+
+
+SCHEMA_SQL = """
+CREATE TABLE llm_calls (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    provider TEXT NOT NULL,
+    model_id TEXT NOT NULL,
+    tier TEXT NOT NULL,
+    feature_name TEXT NOT NULL,
+    actor TEXT,
+    status TEXT NOT NULL,
+    duration_ms INTEGER NOT NULL DEFAULT 0,
+    cost_usd REAL NOT NULL DEFAULT 0,
+    error_message TEXT,
+    iter INTEGER,
+    run_id TEXT,
+    traceparent TEXT,
+    input_tokens INTEGER NOT NULL DEFAULT 0,
+    output_tokens INTEGER NOT NULL DEFAULT 0,
+    total_tokens INTEGER NOT NULL DEFAULT 0,
+    metadata_json TEXT NOT NULL DEFAULT '{}',
+    session_id TEXT,
+    cached_input_tokens INTEGER DEFAULT 0,
+    cache_creation_input_tokens INTEGER DEFAULT 0,
+    cost_input_uncached_usd REAL DEFAULT 0,
+    cost_input_cached_usd REAL DEFAULT 0,
+    cost_cache_write_usd REAL DEFAULT 0
+);
+"""
+
+
+def _seed_db(db_path: Path, rows: list[dict]) -> None:
+    """Seed ``db_path`` with the full schema + a handful of fixture rows."""
+    con = sqlite3.connect(str(db_path))
+    con.executescript(SCHEMA_SQL)
+    for row in rows:
+        con.execute(
+            """
+            INSERT INTO llm_calls (
+                provider, model_id, tier, feature_name, actor, status,
+                duration_ms, cost_usd, input_tokens, output_tokens,
+                cached_input_tokens, cache_creation_input_tokens,
+                cost_input_uncached_usd, cost_input_cached_usd,
+                cost_cache_write_usd
+            ) VALUES (
+                :provider, :model_id, :tier, :feature_name, :actor, :status,
+                :duration_ms, :cost_usd, :input_tokens, :output_tokens,
+                :cached_input_tokens, :cache_creation_input_tokens,
+                :cost_input_uncached_usd, :cost_input_cached_usd,
+                :cost_cache_write_usd
+            )
+            """,
+            row,
+        )
+    con.commit()
+    con.close()
+
+
+def _invoke(argv: list[str], monkeypatch: pytest.MonkeyPatch, env: dict | None = None) -> int:
+    """Run the backfill script as a module (load + main()) so the same code
+    path an operator hits from the CLI is exercised here. env overrides
+    MINI_ORK_HOME / MINI_ORK_DB so we never touch a real DB."""
+    import importlib.util
+
+    spec = importlib.util.spec_from_file_location("llm_calls_cost_backfill", SCRIPT_PATH)
+    assert spec and spec.loader
+    module = importlib.util.module_from_spec(spec)
+    sys.modules["llm_calls_cost_backfill"] = module
+    spec.loader.exec_module(module)
+    return module.main(argv)
+
+
+@pytest.fixture
+def isolate_db(monkeypatch):
+    """Default MINI_ORK_HOME points at .mini-ork; redirect to /tmp so the
+    backfill's default DB resolver doesn't touch a real DB."""
+    monkeypatch.delenv("MINI_ORK_DB", raising=False)
+    monkeypatch.setenv("MINI_ORK_HOME", "/tmp/mini-ork-backfill-test-home")
+
+
+def test_dry_run_does_not_modify_db(tmp_path: Path, isolate_db, monkeypatch) -> None:
+    """Default mode (no --apply) MUST leave every row's breakdown columns
+    unchanged."""
+    db = tmp_path / "state.db"
+    _seed_db(
+        db,
+        [
+            {
+                "provider": "anthropic",
+                "model_id": "sonnet",
+                "tier": "default",
+                "feature_name": "mini-ork:test",
+                "actor": "tester",
+                "status": "success",
+                "duration_ms": 100,
+                "cost_usd": 0.009,
+                "input_tokens": 1000,
+                "output_tokens": 25,
+                "cached_input_tokens": 200,
+                "cache_creation_input_tokens": 300,
+                # Pre-fix incorrect breakdown (subtraction):
