+    assert cost_usd == pytest.approx(0.009)
+    # Anthropic INPUT_INCLUDES_CACHE=False → uncached_in = input_tokens = 1000.
+    assert uncached == pytest.approx(1000 * 15.0 / 1_000_000)
+    assert cached == pytest.approx(200 * 1.5 / 1_000_000)
