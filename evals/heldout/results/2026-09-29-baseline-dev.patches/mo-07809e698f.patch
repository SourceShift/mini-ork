+def test_apply_reprices_openai_rows_with_subtraction(tmp_path: Path, monkeypatch) -> None:
+    """OpenAI gpt-5 / codex: input_tokens INCLUDES cache, so the new math
+    subtracts cached + cache_creation to get fresh input. Codex rates
+    (1.25 / 0.125 / 0.0)."""
+    monkeypatch.delenv("MINI_ORK_DB", raising=False)
+    monkeypatch.setenv("MINI_ORK_HOME", "/tmp/no-home")
+    db = tmp_path / "state.db"
+    _seed_db(
+        db,
+        [
+            {
+                "provider": "openai",
+                "model_id": "gpt-5",
+                "tier": "default",
+                "feature_name": "mini-ork:test",
+                "actor": "tester",
+                "status": "success",
+                "duration_ms": 100,
+                "cost_usd": 0.123,
+                "input_tokens": 10_000,
+                "output_tokens": 500,
+                "cached_input_tokens": 2_000,
+                "cache_creation_input_tokens": 0,
+                "cost_input_uncached_usd": 10.0,   # wildly wrong (anthropic rates)
+                "cost_input_cached_usd": 1.0,
+                "cost_cache_write_usd": 0.0,
+            }
+        ],
+    )
+
+    rc = _invoke(["--db", str(db), "--apply"], monkeypatch)
+    assert rc == 0
+
+    con = sqlite3.connect(str(db))
+    (uncached, cached, cw) = con.execute(
+        "SELECT cost_input_uncached_usd, cost_input_cached_usd, "
+        "cost_cache_write_usd FROM llm_calls"
+    ).fetchone()
+    in_tok = con.execute("SELECT input_tokens FROM llm_calls").fetchone()[0]
+    con.close()
+    assert in_tok == 10_000  # untouched
+    # fresh_in = 10_000 - 2_000 - 0 = 8_000 → 8_000 * 1.25 / 1M
+    assert uncached == pytest.approx(8_000 * 1.25 / 1_000_000)
+    assert cached == pytest.approx(2_000 * 0.125 / 1_000_000)
+    # openai (codex) has no cache_creation signal → 0
+    assert cw == 0.0
