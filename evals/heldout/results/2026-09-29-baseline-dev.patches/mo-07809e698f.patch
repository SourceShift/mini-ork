new file mode 100644
index 00000000..7fc608a3
--- /dev/null
+++ b/scripts/llm_calls_cost_backfill.py
@@ -0,0 +1,267 @@
+#!/usr/bin/env python3
+"""Recompute the cache-aware cost breakdown columns in ``llm_calls``.
+
+The ``cost_input_uncached_usd`` / ``cost_input_cached_usd`` /
+``cost_cache_write_usd`` columns were historically priced every provider at
+Anthropic list rates (15 / 1.5 / 18.75 USD per MTok) and unconditionally
+subtracted cached+cache_creation from input_tokens. Live data proved both
+assumptions wrong:
+
+  - anthropic rows went to $0.0017 uncached cost (the subtraction zeroed
+    fresh input the envelope already excludes cache from; receipt rows
+    had input=44k / cached=261k);
+  - codex (OpenAI gpt-5) rows reported ~$1,160 vs the real $115.73
+    (rates + cache-subtraction mismatch compounded);
+  - gateway rows reported ~$815 fabricated cost vs $607.64 real envelope
+    total — the breakdown invented phantom dollars.
+
+The fix lives in ``mini_ork.dispatch.telemetry.cache_aware_cost``: per-family
+``INPUT_INCLUDES_CACHE`` semantics + ``FAMILY_RATES`` table. This script is
+the retroactive sweep that re-prices historical rows under the new rules.
+
+Hard contract:
+  - DRY-RUN BY DEFAULT. Pass ``--apply`` to actually write rows. Without
+    ``--apply`` the script prints what it WOULD change and exits 0.
+  - Never touches ``input_tokens`` / ``output_tokens`` /
+    ``cached_input_tokens`` / ``cache_creation_input_tokens`` /
+    ``cost_usd``. Only the three breakdown columns are recomputed. The
+    original token totals + the provider-reported ``cost_usd`` are the
+    ground truth we are correcting AGAINST, not variables we are allowed
+    to overwrite.
+
+Usage:
+  # default DB (MINI_ORK_DB or $MINI_ORK_HOME/state.db); show proposed changes
+  python3 scripts/llm_calls_cost_backfill.py
+
+  # explicit DB
+  python3 scripts/llm_calls_cost_backfill.py --db /path/to/state.db
+
+  # write to the DB
+  python3 scripts/llm_calls_cost_backfill.py --apply
+
+  # filter to a single provider family (e.g. only "anthropic" rows)
+  python3 scripts/llm_calls_cost_backfill.py --provider anthropic
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import sqlite3
+import sys
+from pathlib import Path
+
+# Allow `python3 scripts/llm_calls_cost_backfill.py` from the repo root —
+# the dispatch layer lives one level up + inside the package.
+_REPO_ROOT = Path(__file__).resolve().parent.parent
+if str(_REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(_REPO_ROOT))
+
+from mini_ork.context import context_env  # noqa: E402
+from mini_ork.dispatch.telemetry import (  # noqa: E402
+    FAMILY_RATES,
+    INPUT_INCLUDES_CACHE,
+    cache_aware_cost,
+)
+from mini_ork.dispatch.models import TokenUsage  # noqa: E402
+
+
+def _default_db_path() -> Path:
+    """Resolve the llm_calls DB: $MINI_ORK_DB → $MINI_ORK_HOME/state.db → ./state.db."""
+    explicit = context_env("MINI_ORK_DB")
+    if explicit:
+        return Path(explicit)
+    home = context_env("MINI_ORK_HOME")
+    if home:
+        return Path(home) / "state.db"
+    return Path.cwd() / "state.db"
+
+
+def _existing_breakdown_columns(con: sqlite3.Connection) -> set[str]:
+    """The set of cost_*_usd breakdown columns actually present in this DB
+    schema. Old DBs without the 0024 cache-aware migration have none, so the
+    backfill is a no-op there (nothing to recompute)."""
+    try:
+        cols = {row[1] for row in con.execute("PRAGMA table_info(llm_calls)")}
+    except sqlite3.OperationalError:
+        return set()
+    return {c for c in ("cost_input_uncached_usd", "cost_input_cached_usd", "cost_cache_write_usd") if c in cols}
+
+
+def _iter_rows(con: sqlite3.Connection, provider: str | None):
+    """Yield (id, family, input, output, cached, cache_creation) tuples."""
+    sql = (
+        "SELECT id, provider, COALESCE(input_tokens, 0), COALESCE(output_tokens, 0), "
+        "COALESCE(cached_input_tokens, 0), COALESCE(cache_creation_input_tokens, 0) "
+        "FROM llm_calls"
+    )
+    params: tuple = ()
+    if provider:
+        sql += " WHERE provider = ?"
+        params = (provider,)
+    yield from con.execute(sql, params)
+
+
+def _format_change(
+    row_id: int,
+    family: str,
+    old: tuple[float, float, float],
+    new: tuple[float, float, float],
+    usage: TokenUsage,
+) -> str:
+    return (
+        f"id={row_id} family={family} "
+        f"in={usage.input_tokens} out={usage.output_tokens} "
+        f"cached={usage.cached_input_tokens} cache_create={usage.cache_creation_tokens} "
+        f"uncached {old[0]:.6f}→{new[0]:.6f} "
+        f"cached {old[1]:.6f}→{new[1]:.6f} "
+        f"cache_write {old[2]:.6f}→{new[2]:.6f}"
+    )
+
+
+def _summarize(
+    con: sqlite3.Connection,
+    *,
+    apply: bool,
+    provider: str | None,
+    limit: int | None,
+) -> int:
+    """Walk every llm_calls row, recompute the breakdown, print/write.
+
+    Returns the number of rows whose breakdown ACTUALLY CHANGED (zero means
+    nothing to backfill — the historical rows were already correctly priced,
+    or the schema predates the breakdown columns)."""
+    breakdown_cols = _existing_breakdown_columns(con)
+    if len(breakdown_cols) < 3:
+        sys.stderr.write(
+            f"[llm_calls_cost_backfill] llm_calls schema lacks breakdown columns "
+            f"(have {sorted(breakdown_cols)}); nothing to recompute\n"
+        )
+        return 0
+
+    updated = 0
+    scanned = 0
+    plan: list[tuple[int, str, TokenUsage, tuple[float, float, float], tuple[float, float, float]]] = []
+
+    for row_id, family, in_tok, out_tok, cached_tok, cache_create_tok in _iter_rows(con, provider):
+        if limit is not None and updated >= limit:
+            break
+        scanned += 1
+        old = (
+            float(con.execute(
+                "SELECT cost_input_uncached_usd FROM llm_calls WHERE id=?", (row_id,)
+            ).fetchone()[0] or 0.0),
+            float(con.execute(
+                "SELECT cost_input_cached_usd FROM llm_calls WHERE id=?", (row_id,)
+            ).fetchone()[0] or 0.0),
+            float(con.execute(
+                "SELECT cost_cache_write_usd FROM llm_calls WHERE id=?", (row_id,)
+            ).fetchone()[0] or 0.0),
+        )
+        usage = TokenUsage(
+            input_tokens=int(in_tok),
+            output_tokens=int(out_tok),
+            cached_input_tokens=int(cached_tok),
+            cache_creation_tokens=int(cache_create_tok),
+        )
+        new = cache_aware_cost(usage, family=family or "anthropic")
+        if (
+            abs(old[0] - new[0]) > 1e-9
+            or abs(old[1] - new[1]) > 1e-9
+            or abs(old[2] - new[2]) > 1e-9
+        ):
+            updated += 1
+            plan.append((row_id, family or "anthropic", usage, old, new))
+
+    if not apply:
+        sys.stdout.write(
+            f"[llm_calls_cost_backfill] DRY-RUN scanned={scanned} would_update={updated} "
+            f"db={con.execute('PRAGMA database_list').fetchone()[2] if False else ''}\n"
+        )
+        for row_id, family, usage, old, new in plan[:50]:
+            sys.stdout.write(_format_change(row_id, family, old, new, usage) + "\n")
+        if len(plan) > 50:
+            sys.stdout.write(f"[llm_calls_cost_backfill] …and {len(plan) - 50} more\n")
+        sys.stdout.write(
+            "[llm_calls_cost_backfill] Pass --apply to write these changes.\n"
+        )
+        return updated
+
+    if not plan:
+        sys.stdout.write(f"[llm_calls_cost_backfill] scanned={scanned} updated=0 (no changes)\n")
+        return 0
+
+    con.execute("BEGIN")
+    try:
+        for row_id, _family, usage, old, new in plan:
+            con.execute(
+                "UPDATE llm_calls SET "
+                "cost_input_uncached_usd=?, cost_input_cached_usd=?, cost_cache_write_usd=? "
+                "WHERE id=?",
+                (new[0], new[1], new[2], row_id),
+            )
+        con.commit()
+    except Exception:
+        con.rollback()
+        raise
+    sys.stdout.write(
+        f"[llm_calls_cost_backfill] APPLIED scanned={scanned} updated={updated}\n"
+    )
+    for row_id, family, usage, old, new in plan[:50]:
+        sys.stdout.write(_format_change(row_id, family, old, new, usage) + "\n")
+    if len(plan) > 50:
+        sys.stdout.write(f"[llm_calls_cost_backfill] …and {len(plan) - 50} more\n")
+    return updated
+
+
+def main(argv: list[str] | None = None) -> int:
+    argv = list(sys.argv[1:] if argv is None else argv)
+    parser = argparse.ArgumentParser(
+        description="Recompute llm_calls cache-aware cost breakdown under the "
+        "new family-keyed INPUT_INCLUDES_CACHE + FAMILY_RATES rules.",
+    )
+    parser.add_argument(
+        "--db", default=None,
+        help="Path to the SQLite DB. Default: $MINI_ORK_DB → $MINI_ORK_HOME/state.db → ./state.db.",
+    )
+    parser.add_argument(
+        "--apply", action="store_true",
+        help="Write the recomputed breakdown. Default: dry-run (print proposed changes).",
+    )
+    parser.add_argument(
+        "--provider", default=None,
+        help="Restrict the sweep to one provider family (e.g. 'anthropic').",
+    )
+    parser.add_argument(
+        "--limit", type=int, default=None,
+        help="Stop after recomputing this many rows (useful for sampling).",
+    )
+    args = parser.parse_args(argv)
+
+    db_path = Path(args.db) if args.db else _default_db_path()
+    if not db_path.is_file():
+        sys.stderr.write(f"[llm_calls_cost_backfill] DB not found: {db_path}\n")
+        return 2
+
+    # Surface the family tables so an operator can sanity-check before --apply.
+    sys.stdout.write(
+        f"[llm_calls_cost_backfill] db={db_path} mode={'APPLY' if args.apply else 'DRY-RUN'}\n"
+        f"[llm_calls_cost_backfill] INPUT_INCLUDES_CACHE={INPUT_INCLUDES_CACHE}\n"
+        f"[llm_calls_cost_backfill] FAMILY_RATES={FAMILY_RATES}\n"
+    )
+
+    con = sqlite3.connect(str(db_path), timeout=10)
+    try:
+        con.execute("PRAGMA busy_timeout=5000")
+        _summarize(
+            con,
+            apply=args.apply,
+            provider=args.provider,
+            limit=args.limit,
+        )
+    finally:
+        con.close()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
