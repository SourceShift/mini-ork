+def _revert_inplace_diff(root: str, run_dir: str) -> bool:
+    """``keep_run_artifacts_discard_worktree`` compensation (in-place recipes).
+
+    Reverses the run's own ``framework-edit.diff`` so the next serial epic
+    starts from a clean base. The in-place agent may leave any mix of states
+    (tracked edits, untracked creates, staged-but-not-committed, partial
+    reverts), so the restore is per-path and state-agnostic:
+
+      * paths present in HEAD → ``git checkout HEAD -- <path>`` resets BOTH
+        the index entry AND the worktree content (a bare ``git apply -R``
+        only reverts worktree content and leaves the agent's staged entries
+        behind — observed live).
+      * created paths (absent from HEAD) → unstaged and unlinked.
+      * paths outside the recorded delta → never touched.
+
+    Containment check keeps a traversing diff path (``..``/absolute/
+    symlink-escape) from reaching outside ``MO_TARGET_CWD`` (the publisher's
+    OSS-leak guard, identical to revert_branch). Run artifacts under
+    ``run_dir`` (diff, verdicts, logs) survive — the strategy's name states
+    the contract; discarding them would defeat the point of the recipe's own
+    artifact_contract.
+    """
+    def log(msg):
+        print(msg, file=sys.stderr, flush=True)
+
+    files: list[str] = _run_changed_files(run_dir)
+    if not files:
+        log("  [rollback] keep_run_artifacts_discard_worktree: no files_changed recorded — working tree untouched")
+        return True
+    target_repo = context_env("MO_TARGET_CWD", "")
+    if not target_repo:
+        try:
+            target_repo = subprocess.check_output(
+                ["git", "-C", root or ".", "rev-parse", "--show-toplevel"],
+                stderr=subprocess.DEVNULL).decode().strip()
+        except Exception:
+            target_repo = root or "."
+    real_root = os.path.realpath(target_repo)
+    restored, removed, rejected = [], [], []
+    for raw in files:
+        ap = raw if os.path.isabs(raw) else os.path.join(real_root, raw)
+        real = os.path.realpath(ap)
+        # Containment check: a traversing diff path (``../foo``, an absolute
+        # path outside the target, a symlink whose target escapes) must be
+        # refused before any destructive operation, mirroring the publisher's
+        # OSS-leak guard so the two readers of the same files agree.
+        if real != real_root and not real.startswith(real_root + os.sep):
+            rejected.append(raw)
+            log(f"  [rollback] keep_run_artifacts_discard_worktree: reject-revert: "
+                f"path escapes target repo: {raw}")
+            continue
+        rel = os.path.relpath(real, real_root)
+        tracked = subprocess.run(
+            ["git", "-C", real_root, "ls-files", "--error-unmatch", "--", rel],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
+        if tracked:
+            # ``git checkout HEAD -- <path>`` resets BOTH the index entry AND
+            # the worktree content — a bare ``git apply -R`` would only
+            # revert worktree content and leave the agent's staged entries
+            # behind (which would then re-apply on the next checkout).
+            rc = subprocess.run(
+                ["git", "-C", real_root, "checkout", "HEAD", "--", rel],
+                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
+            if rc == 0:
+                restored.append(rel)
+            else:
+                rejected.append(raw)
+        else:
+            # Implementer-created file (absent from HEAD): unstage any
+            # leftover index entry, then unlink.
+            try:
+                subprocess.run(
+                    ["git", "-C", real_root, "rm", "--cached", "--ignore-unmatch", "--", rel],
+                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            except Exception:
+                pass
+            try:
+                if os.path.isfile(real):
+                    os.remove(real)
+                    removed.append(rel)
+                elif os.path.isdir(real):
+                    # Never recursively delete: a created directory whose
+                    # contents were never staged could be live work the
+                    # operator placed there. Report and skip.
+                    log(f"  [rollback] keep_run_artifacts_discard_worktree: skipping non-empty "
+                        f"created dir (likely operator work): {raw}")
+                    rejected.append(raw)
+            except OSError:
+                rejected.append(raw)
+    log(f"  [rollback] keep_run_artifacts_discard_worktree: restored {len(restored)} tracked file(s), "
+        f"removed {len(removed)} created file(s), rejected {len(rejected)}; run artifacts preserved")
+    leftover = subprocess.run(
+        ["git", "-C", real_root, "status", "--porcelain", "--", *files],
+        capture_output=True, text=True).stdout.strip()
+    if leftover:
+        log(f"  [warn] rollback: leftover changes after keep_run_artifacts_discard_worktree:\n{leftover}")
+        return False
+    return True
+
