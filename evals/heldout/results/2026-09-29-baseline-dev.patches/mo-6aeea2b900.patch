+# ─────────────────────────────────────────────────────────────────────────
+# Per-unit kickoff templating
+# ─────────────────────────────────────────────────────────────────────────
+
+
+_UNIT_ID_SLUG_RE = re.compile(r"[^A-Za-z0-9_.-]")
+
+
+def _slugify_unit_id(unit_id: str) -> str:
+    """Filesystem-safe slug of ``unit_id`` — replace any char that would break a
+    filename (notably ``/``, which unit ids routinely contain because they're
+    usually relative repo paths) with ``_``. Empty input falls back to ``"x"``
+    so the resulting filename is never blank.
+    """
+    return _UNIT_ID_SLUG_RE.sub("_", unit_id or "x")
+
+
+def _render_kickoff_template(text: str, unit_id: str, reason: str) -> str | None:
+    """Materialize ``{{unit_id}}`` / ``{{reason}}`` into the kickoff body.
+
+    A kickoff template without placeholders passes through unchanged (returns
+    ``None`` so the caller knows a per-unit copy is unnecessary and the original
+    template file may be reused as-is). With at least one placeholder present,
+    substitution is plain text replacement — no slugging of ``{{unit_id}}``
+    because the substitution value is a CONTENT field, not a filename; the
+    slug is applied separately when the per-unit temp filename is derived.
+    """
+    has_unit = "{{unit_id}}" in text
+    has_reason = "{{reason}}" in text
+    if not has_unit and not has_reason:
+        return None
+    rendered = text
+    if has_unit:
+        rendered = rendered.replace("{{unit_id}}", str(unit_id or ""))
+    if has_reason:
+        rendered = rendered.replace("{{reason}}", str(reason or ""))
+    return rendered
+
+
