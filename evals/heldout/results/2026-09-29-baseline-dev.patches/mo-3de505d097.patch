+def _load_rolled_back_paths(run_dir):
+    """The set of paths this run's rollback reverted (so verify can label them).
+
+    Reads ``<run_dir>/rolled-back.json`` if it exists. The manifest is written
+    by ``_revert_working_tree`` / ``_revert_inplace_diff`` (kickoff
+    §rollback/verify); without it, the post-rollback verifier blames the
+    implementer for files rollback itself deleted. Empty set on missing file
+    or unreadable payload — verify falls back to its existing label.
+    """
+    if not run_dir or not os.path.isdir(run_dir):
+        return set()
+    path = os.path.join(run_dir, "rolled-back.json")
+    if not os.path.isfile(path):
+        return set()
+    try:
+        with open(path, encoding="utf-8") as fh:
+            data = json.load(fh)
+    except (OSError, ValueError):
+        return set()
+    if not isinstance(data, dict):
+        return set()
+    out: set[str] = set()
+    for key in ("reverted_paths", "removed_paths"):
+        for p in data.get(key, []) or []:
+            if isinstance(p, str) and p:
+                out.add(p)
+    return out
+
