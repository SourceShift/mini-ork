+def _effective_agents_yaml_path() -> str:
+    """Resolve the canonical agents.yaml (run-dir first, then HOME, then ROOT).
+
+    Mirrors ``config_resolve.resolve_agents_yaml`` precedence in-place so this
+    module stays self-contained for the lane-lookup branch. Returns "" when
+    no config exists in any of the three locations; callers fall back.
+    """
+    run_dir = os.environ.get("MINI_ORK_RUN_DIR", "")
+    if run_dir:
+        cand = os.path.join(run_dir, "config", "agents.yaml")
+        if os.path.isfile(cand):
+            return cand
+    home = os.environ.get("MINI_ORK_HOME", "")
+    if home:
+        cand = os.path.join(home, "config", "agents.yaml")
+        if os.path.isfile(cand):
+            return cand
+    root = os.environ.get("MINI_ORK_ROOT", "")
+    if root:
+        cand = os.path.join(root, "config", "agents.yaml")
+        if os.path.isfile(cand):
+            return cand
+    return ""
+
+
+def _agents_yaml_role_lane(role: str) -> str:
+    """The lane mapped to ``role`` in the operator's agents.yaml, or "".
+
+    Operator sets ``lanes.<role>`` in agents.yaml precisely to override the
+    frontier/cheap defaults (kickoff §routing). Returning "" for a missing
+    file, malformed yaml, or unmapped role lets the caller fall through to
+    the defaults without raising — config errors are NEVER a run sink.
+    """
+    path = _effective_agents_yaml_path()
+    if not path:
+        return ""
+    try:
+        import yaml
+
+        with open(path, encoding="utf-8") as fh:
+            data = yaml.safe_load(fh)
+        lanes = (data or {}).get("lanes") or {}
+        if not isinstance(lanes, dict):
+            return ""
+        val = lanes.get(role)
+        return str(val).strip() if val else ""
+    except Exception:
+        return ""
+
