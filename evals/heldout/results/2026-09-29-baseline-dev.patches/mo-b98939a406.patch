+def _poll_until_settled(
+    success_fn: Callable[[], int],
+    fail_fn: Callable[[], int] | None,
+    *,
+    timeout_s: int,
+    poll_s: int,
+) -> dict[str, Any]:
+    """Poll success FIRST each cycle, then the (optional) fail probe.
+
+    Both probes use the same inverted convention as :func:`_poll_until_zero`
+    (rc=0 == signal raised). The success probe wins ties: a unit that BOTH
+    passes the goal predicate AND trips the terminal-fail probe in the same
+    window is reported as ``terminal=False, settled=True`` so a worker that
+    finally completes the chapter does not lose to a parallel failure just
+    declared by a stall detector. Returning ``settled/terminal/reason``
+    lets the caller tell goal_met from terminal_failure from timeout without
+    re-deriving the rc logic.
+
+    ``fail_fn=None`` collapses to the historical wait-for-success-only loop
+    (one probe per cycle, same shape as :func:`_poll_until_zero`), so unarmed
+    loops — MO_GOAL_TERMINAL_FAIL_CMD unset — are byte-for-byte unchanged.
+    """
+    step = poll_s if poll_s > 0 else (timeout_s + 1)
+    waited = 0
+    last_pass: int | None = None
+    last_fail: int | None = None
+    while True:
+        last_pass = success_fn()
+        if last_pass == 0:
+            return {
+                "settled": True,
+                "terminal": False,
+                "reason": "goal_met",
+                "waited_s": waited,
+                "last_pass_rc": last_pass,
+                "last_fail_rc": last_fail,
+            }
+        if fail_fn is not None:
+            last_fail = fail_fn()
+            if last_fail == 0:
+                return {
+                    "settled": True,
+                    "terminal": True,
+                    "reason": "terminal_failure",
+                    "waited_s": waited,
+                    "last_pass_rc": last_pass,
+                    "last_fail_rc": last_fail,
+                }
+        else:
+            last_fail = None
+        if waited >= timeout_s:
+            return {
+                "settled": False,
+                "terminal": False,
+                "reason": "timeout",
+                "waited_s": waited,
+                "last_pass_rc": last_pass,
+                "last_fail_rc": last_fail,
+            }
+        if poll_s > 0:
+            time.sleep(poll_s)
+        waited += step
+
+
