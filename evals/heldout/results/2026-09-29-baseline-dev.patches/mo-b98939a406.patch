+#!/usr/bin/env python3
+"""fail-cmd for the goal-loop: has chapter <n> of BOOK_UUID terminally failed?
+
+Contract (recipes/goal-loop/lib/transforms.py::_await_terminal via
+_poll_until_settled): invoked as
+``python3 chapter_terminal_fail.py <chapter_number>`` (argv, not shell).
+Exit code is INVERTED vs the goal predicate:
+
+  exit 0 == the chapter is terminally failed (success for the fail-probe)
+  exit 1 == the chapter has NOT terminally failed (keep waiting)
+  exit 2 == bad input / missing config (conservative; the loop will keep waiting)
+  exit 3 == DB error (conservative; the loop will keep waiting and surface)
+
+The first stdout/stderr line is captured as the reason text. The consumer
+(_poll_until_settled) checks the success probe FIRST each cycle — a unit that
+both passes the goal predicate AND trips this fail probe in the same window is
+reported as passed, so a worker that finally completes right as we declare
+terminal failure still wins.
+
+Three terminal-failure signals, all checked against ``book_chapter_lifecycle``:
+
+  1. permanently_failed = 't' — always fires (the worker has decided the
+     chapter is hopeless; nothing the loop can do).
+
+  2. status in the failed set (default: failed | degraded | cancelled) — opt-
+     in via MO_GOAL_FAIL_ON_STATUS_FAILED=1 because a chapter can sit in
+     'failed' transiently before a retry (so the loop must not pounce on the
+     first sight of the string).
+
+  3. STALL — opt-in via MO_GOAL_STALL_SECONDS > 0 (set to 0 to disable). All
+     three must hold: status='generating', last_error is non-empty (the
+     worker is actively failing), and the newest ``run-*`` directory under
+     MO_GOAL_RUNS_DIR is at least MO_GOAL_STALL_SECONDS stale. Run-dir
+     freshness is the stall signal — NOT lifecycle.updated_at, which stays
+     frozen at the last chapter milestone during a HEALTHY long generation;
+     keying a stall on updated_at would kill healthy long gens.
+
+Conservative non-terminal cases (the loop keeps waiting):
+  * DB error / query failure
+  * missing lifecycle row for the chapter
+  * committed_complete = 't' — the chapter is actually done, NOT failed
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+
+# Statuses that count as terminally failed when MO_GOAL_FAIL_ON_STATUS_FAILED=1.
+# 'failed' / 'degraded' / 'cancelled' are the book-goal-loop's settled-bad
+# outcomes; a transient 'failed' before retry is filtered by the opt-in gate.
+_FAILED_STATUSES = frozenset({"failed", "degraded", "cancelled"})
+
+
+def _q(sql: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [
+            "psql",
+            "-h", os.environ.get("PGHOST", "REDACTED-INTERNAL-IP"),
+            "-p", os.environ.get("PGPORT", "5932"),
+            "-U", os.environ.get("PGUSER", "researcher_user"),
+            "-d", os.environ.get("PGDATABASE", "researcher_db"),
+            "-tA", "-F", "|", "-c", sql,
+        ],
+        capture_output=True,
+        text=True,
+    )
+
+
+def _int_env(name: str, default: int) -> int:
+    raw = os.environ.get(name)
+    if raw is None or raw.strip() == "":
+        return default
+    try:
+        return int(raw.strip())
+    except ValueError:
+        return default
+
+
+def _bool_env(name: str) -> bool:
+    raw = os.environ.get(name, "").strip()
+    return raw == "1"
+
+
+def _stall_seconds() -> int:
+    return _int_env("MO_GOAL_STALL_SECONDS", 0)
+
+
+def _runs_dir() -> str:
+    return os.environ.get("MO_GOAL_RUNS_DIR", "").strip()
+
+
+def _newest_run_mtime(runs_dir: str) -> float | None:
+    """Return the most-recent mtime (seconds) of any ``run-*`` child, or None.
+
+    A missing directory or one with no ``run-*`` children yields None — the
+    caller treats that as "no stall signal" rather than an error, because a
+    worker that hasn't produced a run dir yet is not necessarily stalled.
+    """
+    try:
+        root = Path(runs_dir)
+    except (OSError, ValueError):
+        return None
+    if not root.is_dir():
+        return None
+    newest: float | None = None
+    try:
+        for child in root.iterdir():
+            if not child.is_dir():
+                continue
+            if not child.name.startswith("run-"):
+                continue
+            try:
+                mtime = child.stat().st_mtime
+            except OSError:
+                continue
+            if newest is None or mtime > newest:
+                newest = mtime
+    except OSError:
+        return None
+    return newest
+
+
+def main(argv: list[str]) -> int:
+    if not argv:
+        print("usage: chapter_terminal_fail.py <chapter_number>", file=sys.stderr)
+        return 2
+    chapter = argv[0].strip()
+    if not re.fullmatch(r"\d+", chapter):
+        print(f"bad chapter id: {chapter!r}", file=sys.stderr)
+        return 2
+    book = os.environ.get("BOOK_UUID", "").strip()
+    if not re.fullmatch(r"[0-9a-fA-F-]{36}", book):
+        print(f"BOOK_UUID unset/invalid: {book!r}", file=sys.stderr)
+        return 2
+
+    sql = (
+        "SELECT status, "
+        "committed_complete, "
+        "permanently_failed, "
+        "generation_attempts, "
+        "coalesce(last_error,''), "
+        "coalesce(degraded,'f') "
+        "FROM book_chapter_lifecycle "
+        f"WHERE book_uuid='{book}' AND chapter_number={chapter};"
+    )
+    proc = _q(sql)
+    if proc.returncode != 0:
+        print(f"ch{chapter} db-error: {proc.stderr.strip()[:80]}")
+        return 3
+
+    rows = proc.stdout.strip().splitlines()
+    if not rows:
+        print(f"ch{chapter} missing: no lifecycle row for this chapter")
+        return 1
+
+    cols = (rows[0].split("|") + [""] * 6)[:6]
+    status, committed, permfail, _attempts, lasterr, degraded = cols
+
+    # Conservative: a chapter marked complete is NOT a terminal failure — it
+    # succeeded. The success probe (chapter_predicate.py) will already have
+    # agreed, but if the race makes us run first, do not false-trip.
+    if committed == "t":
+        print(f"ch{chapter} committed_complete=t — not a terminal failure")
+        return 1
+
+    # 1) permanently_failed=t ALWAYS fires — the worker has given up.
+    if permfail == "t":
+        print(
+            f"ch{chapter} TERMINAL_FAIL permanently_failed=t "
+            f"status={status} degraded={degraded}"
+        )
+        return 0
+
+    # 2) status in the failed set — opt-in because 'failed' can be transient
+    #    before a retry; the loop must not pounce on the first sighting.
+    if _bool_env("MO_GOAL_FAIL_ON_STATUS_FAILED") and status in _FAILED_STATUSES:
+        print(
+            f"ch{chapter} TERMINAL_FAIL status={status} (opt-in) "
+            f"degraded={degraded} err={lasterr[:60]}"
+        )
+        return 0
+
+    # 3) STALL — opt-in via MO_GOAL_STALL_SECONDS > 0. All three conditions
+    #    must hold: the worker is generating, it has a fresh error, and the
+    #    newest run-* dir is stale. Keying on run-dir freshness (NOT
+    #    lifecycle.updated_at) avoids killing healthy long generations whose
+    #    updated_at stays frozen at the last chapter milestone.
+    stall_s = _stall_seconds()
+    runs_dir = _runs_dir()
+    if stall_s > 0 and runs_dir and status == "generating" and lasterr.strip():
+        newest = _newest_run_mtime(runs_dir)
+        if newest is not None:
+            idle = time.time() - newest
+            if idle >= stall_s:
+                print(
+                    f"ch{chapter} TERMINAL_FAIL stall status=generating "
+                    f"err={lasterr[:40]} idle_s={int(idle)} >= {stall_s}"
+                )
+                return 0
+
+    print(
+        f"ch{chapter} not-terminal status={status} committed={committed} "
+        f"permfail={permfail} degraded={degraded}"
+    )
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
