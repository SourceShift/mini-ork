+# failed (permanently_failed=t / opt-in status=failed / opt-in STALL) so the
+# outer loop quarantines + re-plans instead of burning the full
+# MO_GOAL_APPLY_AWAIT_SECONDS window on a hopeless regen. Default unset →
+# _poll_until_settled collapses to the historical wait-for-pass-only loop.
+export MO_GOAL_TERMINAL_FAIL_CMD="${MO_GOAL_TERMINAL_FAIL_CMD:-python3 $BIND/chapter_terminal_fail.py}"
+# Run-dir the stall detector scans (researcher's chapter run-* directories).
+# Override per-deployment if the researcher's run root lives elsewhere.
+export MO_GOAL_RUNS_DIR="${MO_GOAL_RUNS_DIR:-$PRIMARY/runs}"
+# Stall threshold (seconds idle on the newest run-* dir, opt-in). 0 disables.
+# 1200s = 20min ≈ ~10x the goal-loop node cadence, so a healthy long gen
+# (~30s/run-dir churn) never trips; a worker that crashed mid-chapter does.
+export MO_GOAL_STALL_SECONDS="${MO_GOAL_STALL_SECONDS:-1200}"
