+def _review_pathspecs(worktree, declared):
+    """Clean the implementer-declared ``files_changed`` into repo-relative pathspecs.
+
+    ``implementer-summary.files_changed`` is recorded ABSOLUTE because the
+    publisher's commit gate and ``_revert_branch`` need that shape, but ``git
+    diff`` accepts a pathspec only relative to the repo root. An absolute path
+    matched NOTHING and exited 0, so the reviewer diff was a silent empty file.
+    An untracked symlink (e.g. ``baml_client -> /neighbouring/checkout``)
+    resolved outside the repo via ``realpath`` and recorded a path that could never
+    be a pathspec at all. ``_review_pathspecs`` relativizes each declared entry
+    against ``worktree``, drops any that resolve outside the repo, drops pathspec
+    magic (``:(...``, leading ``-``/``--``/``..``, etc.), and returns the cleaned
+    repo-relative list. Order preserved; duplicates dropped.
+    """
+    if not worktree or not os.path.isdir(worktree) or not declared:
+        return []
+    try:
+        repo_real = os.path.realpath(worktree)
+    except OSError:
+        return []
+    out: list[str] = []
+    for raw in declared:
+        if not isinstance(raw, str) or not raw:
+            continue
+        # Drop pathspec magic. Git interprets a leading ``-`` as another option
+        # (e.g. ``--cached``), a leading ``:`` introduces ``:(exclude)`` etc.,
+        # and ``:(`` anywhere is pathspec magic. ``--`` (bare) is harmless but
+        # redundant; drop it.
+        if raw in ("--",) or raw.startswith(("-", ":", "..")):
+            continue
+        if ":(" in raw:
+            continue
+        # Relativize against the declared worktree.
+        try:
+            rel = os.path.relpath(raw, worktree)
+        except ValueError:  # different drives on Windows; bail rather than crash
+            continue
+        if not rel or rel.startswith("..") or os.path.isabs(rel):
+            continue
+        # Drop anything that resolves outside the repo (symlink escape).
+        full = os.path.join(worktree, rel)
+        try:
+            real = os.path.realpath(full)
+        except OSError:
+            continue
+        if real != repo_real and not real.startswith(repo_real + os.sep):
+            continue
+        if rel not in out:
+            out.append(rel)
+    return out
+
+
