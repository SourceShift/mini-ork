+def _sync_upstream(worktree: str) -> tuple[bool, str]:
+    """Merge `origin/main` (or `main`) into the worktree, best-effort.
+
+    Why this exists
+    ---------------
+    The deploy target is a long-lived branch the loop's children commit onto (the
+    `codex/goalloop-fixes`-style branch in the kickoff). It drifts behind main,
+    and a fix merged to main is invisible to the worker here until the branch
+    it actually runs contains it — measured 2026-09-20: the jina figure-preservation
+    fix (ba57a71e4) was on main, but the deploy target was 14 commits behind, so
+    every chapter kept losing its figures while the fix was reported as shipped.
+    The restart is the "make the code live" edge, so we close the gap here,
+    BEFORE the replacement worker spawns — the new worker reads from the same
+    branch the merge just refreshed.
+
+    Best-effort by construction
+    -------------------------
+    A conflict, dirty tree, missing upstream ref, or any tool failure aborts the
+    sync and warns, leaving the worktree byte-identical and never blocking the
+    restart. The restart proceeds regardless: a missing merge-forward is strictly
+    less bad than a held singleton lock, and the operator can `git -C <worktree>
+    merge origin/main` themselves once they see the warning. We refuse to guess
+    at a conflict resolution (-X ours/theirs) — that would be a fabricated fix;
+    a conflict is named (the merge --abort undoes any index/worktree churn) and
+    left for an operator.
+
+    The loop's own commit survives by construction: `git merge` is a 3-way merge
+    that preserves both parents in the resulting merge commit, so the worktree's
+    pre-merge HEAD (the loop's fix) is always an ancestor of the post-merge HEAD.
+    The branch pointer advances; no loop commit is lost.
+
+    MO_GOAL_SYNC_UPSTREAM=0 restores today's behaviour exactly: the function
+    returns immediately without touching git.
+
+    Returns (True, why) on success/skip/conflict — never False. A non-actionable
+    warn is still success at this layer; the restart must not block on it."""
+    if os.environ.get("MO_GOAL_SYNC_UPSTREAM", "1").strip() == "0":
+        return True, "MO_GOAL_SYNC_UPSTREAM=0; upstream sync skipped (legacy behaviour)"
+
+    # 1. Worktree must be a git checkout. A non-sanctioned dir or a missing .git
+    #    means there is nothing to merge into — skip, never raise.
+    probe = subprocess.run(
+        ["git", "-C", worktree, "rev-parse", "--is-inside-work-tree"],
+        capture_output=True, text=True, timeout=10,
+    )
+    if probe.returncode != 0:
+        why = (probe.stderr or probe.stdout or "").strip().splitlines()
+        return True, f"worktree is not a git checkout ({why[-1] if why else 'rev-parse failed'}); upstream sync skipped"
+
+    # 2. Refuse to merge through uncommitted changes. A dirty worktree would
+    #    either lose the changes on `git stash` (we do NOT stash) or block on a
+    #    conflict we can't safely auto-resolve. The operator sees the warning
+    #    and either commits or stashes themselves before the next restart.
+    dirty = subprocess.run(
+        ["git", "-C", worktree, "diff-index", "--quiet", "HEAD", "--"],
+        capture_output=True, text=True, timeout=10,
+    )
+    if dirty.returncode != 0:
+        status = subprocess.run(
+            ["git", "-C", worktree, "status", "--porcelain"],
+            capture_output=True, text=True, timeout=10,
+        )
+        snippet = " | ".join(status.stdout.splitlines()[:3]).strip() or "uncommitted changes"
+        return True, f"worktree tree is dirty ({snippet!r}); upstream sync skipped (refusing to merge through uncommitted changes)"
+
+    # 3. Pick the upstream ref. Prefer `origin/main` (what the prod-push path
+    #    merges — `MO_GOAL_APPLY_CMD` in launch-armed.sh); fall back to a local
+    #    `main` when origin is unreachable so the sync still helps in offline
+    #    reproductions. NEVER refuse to fall back — a stale local `main` is
+    #    better than no forward-merge at all.
+    rev = subprocess.run(
+        ["git", "-C", worktree, "rev-parse", "--verify", "--quiet", "origin/main"],
+        capture_output=True, text=True, timeout=10,
+    )
+    if rev.returncode == 0:
+        upstream = "origin/main"
+    else:
+        rev = subprocess.run(
+            ["git", "-C", worktree, "rev-parse", "--verify", "--quiet", "main"],
+            capture_output=True, text=True, timeout=10,
+        )
+        if rev.returncode == 0:
+            upstream = "main"
+        else:
+            return True, "neither origin/main nor main is resolvable; upstream sync skipped"
+
+    # 4. Merge. Use --no-ff so the loop's commit and main's commit are both
+    #    preserved as parents of the merge commit when there IS something to
+    #    bring in (the "loop's commit survives" invariant in the kickoff is a
+    #    property of the DAG --no-ff produces). When there is nothing to bring
+    #    in (upstream already an ancestor), git prints "Already up to date"
+    #    and exits 0 WITHOUT making a commit — distinct from a real merge, so
+    #    we report it as such. NEVER -X ours/theirs — that would fabricate a
+    #    resolution. On conflict git leaves the worktree in MERGING with
+    #    conflict markers, which we --abort below.
+    merge = subprocess.run(
+        ["git", "-C", worktree, "merge", "--no-ff", "--no-edit", upstream],
+        capture_output=True, text=True, timeout=120,
+    )
+    if merge.returncode == 0:
+        out = (merge.stdout or "") + (merge.stderr or "")
+        if "Already up to date" in out or "Already up-to-date" in out:
+            return True, f"worktree Already up to date with {upstream}; nothing to merge"
+        return True, f"merged {upstream} into worktree (loop's commit preserved as a merge parent)"
+
+    # 5. Conflict. git left the worktree in MERGING with conflict markers and a
+    #    dirty index. --abort restores HEAD byte-identically (per git-merge docs:
+    #    "resets the index and updates the files in the working tree"). Report
+    #    the first stderr line as the operator's handle — the file + line in
+    #    the conflict output is enough to locate the resolution site.
+    abort = subprocess.run(
+        ["git", "-C", worktree, "merge", "--abort"],
+        capture_output=True, text=True, timeout=10,
+    )
+    err = (merge.stderr or merge.stdout or "").strip().splitlines()
+    hint = err[0] if err else "conflict"
+    if abort.returncode != 0:
+        # --abort failing means the worktree was NOT in MERGING (rare: a hook
+        # already cleared it). Surface that explicitly — the operator must
+        # inspect before any next restart, since we cannot prove the tree is
+        # byte-identical to HEAD.
+        return True, f"merge conflict while merging {upstream} ({hint!r}); --abort FAILED ({abort.stderr.strip()!r}) — worktree may NOT be at HEAD, operator must inspect"
+    return True, f"merge conflict while merging {upstream} ({hint!r}); left worktree at HEAD, named for operator"
+
+
