+# ── upstream-sync (merge forward on every worker restart) ────────────────────
+#
+# Why the deploy target drifts
+# -----------------------------
+# The worker's deploy branch (`codex/goalloop-fixes`-style long-lived branch) is
+# where the loop's children commit; main lands fixes out-of-band. A merge to main
+# is invisible to the worker here until the branch it actually runs contains it
+# (measured 2026-09-20: 14 commits of drift, every chapter losing its figures
+# while the fix was reported shipped). The restart is the only edge where the
+# fix can land on the running worker, so the merge-forward fires here.
+#
+# These tests are hermetic — they use real git in tmp_path to prove the merge
+# actually creates a merge commit (loop commit survives) and that `git merge
+# --abort` restores HEAD byte-identically on conflict. The merge logic lives in
+# `_sync_upstream` and is best-effort by construction: every branch returns
+# True, never aborts the restart.
+
+_GIT_ENV = ("GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@x GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@x ")
+
+
+def _init_git(root, branch="main"):
+    """Init a git repo at `root` on `branch` with one empty commit (so the worktree
+    is a valid git checkout the function can rev-parse, status, and merge into)."""
+    import subprocess
+
+    root.mkdir(parents=True, exist_ok=True)
+    subprocess.run(["git", "init", "-q", "--initial-branch", branch], cwd=str(root), check=True)
+    subprocess.run(["git", "config", "user.email", "t@x"], cwd=str(root), check=True)
+    subprocess.run(["git", "config", "user.name", "T"], cwd=str(root), check=True)
+    subprocess.run(["git", "commit", "-q", "--allow-empty", "-m", "init"], cwd=str(root), check=True)
+
+
+def _git(cwd, *args):
+    import subprocess
+
+    return subprocess.run(
+        ["git", "-C", str(cwd)] + list(args), capture_output=True, text=True
+    )
+
+
+def _head(cwd):
+    import subprocess
+
+    return subprocess.check_output(
+        ["git", "-C", str(cwd), "rev-parse", "HEAD"], text=True
+    ).strip()
+
+
+def _status_clean(cwd):
+    import subprocess
+
+    return subprocess.run(
+        ["git", "-C", str(cwd), "status", "--porcelain"], capture_output=True, text=True
+    ).stdout.strip() == ""
+
+
+def test_sync_upstream_opt_out_is_noop(mod, monkeypatch, tmp_path):
+    """MO_GOAL_SYNC_UPSTREAM=0 restores pre-fix behaviour: subprocess.run is never
+    invoked, so the worktree is byte-identical AND we never even read git state."""
+    _init_git(tmp_path)
+    monkeypatch.setenv("MO_GOAL_SYNC_UPSTREAM", "0")
+
+    def boom(*a, **k):
+        raise AssertionError("subprocess.run must not be called when opted out")
+
+    monkeypatch.setattr(mod.subprocess, "run", boom)
+    ok, why = mod._sync_upstream(str(tmp_path))
+    assert ok is True and "MO_GOAL_SYNC_UPSTREAM=0" in why and "legacy" in why
+
+
+def test_sync_upstream_opt_out_defaults_to_running_when_unset(mod, monkeypatch, tmp_path):
+    """Unset MO_GOAL_SYNC_UPSTREAM defaults to enabled — the kickoff fix IS the
+    default behaviour, not an opt-in."""
+    monkeypatch.delenv("MO_GOAL_SYNC_UPSTREAM", raising=False)
+    _init_git(tmp_path)
+    # main has a commit ahead of feature (no conflict), feature is HEAD
+    (tmp_path / "from-main.txt").write_text("m")
+    _git(tmp_path, "add", "from-main.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "m").check_returncode()
+    # Branch feature from BEFORE main's commit so main is AHEAD (no Already-up-to-date no-op)
+    _git(tmp_path, "checkout", "-q", "HEAD~1").check_returncode()
+    _git(tmp_path, "checkout", "-q", "-b", "feature").check_returncode()
+    (tmp_path / "from-feature.txt").write_text("f")
+    _git(tmp_path, "add", "from-feature.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "f").check_returncode()
+
+    ok, why = mod._sync_upstream(str(tmp_path))
+    assert ok is True and "merged" in why  # ran by default
+
+
+def test_sync_upstream_not_a_git_worktree_skips(mod, monkeypatch, tmp_path):
+    """A non-git worktree is not a failure — there is simply nothing to sync into.
+    The restart must not block on a missing .git."""
+    # tmp_path is fresh, not a git repo
+    import subprocess
+
+    real_run = subprocess.run
+
+    def spy(*args, **kwargs):
+        argv = args[0] if args else kwargs.get("args", [])
+        if "merge" in argv:
+            raise AssertionError(f"must not run `merge` on a non-git worktree; saw {argv!r}")
+        return real_run(*args, **kwargs)
+
+    monkeypatch.setattr(mod.subprocess, "run", spy)
+    ok, why = mod._sync_upstream(str(tmp_path))
+    assert ok is True and "not a git checkout" in why
+
+
+def test_sync_upstream_dirty_tree_skips(mod, tmp_path):
+    """Uncommitted changes block the merge — the operator must clean the tree
+    (commit or stash) before the next restart. The warning names the first few
+    dirty files so the operator doesn't have to run `git status` themselves."""
+    _init_git(tmp_path)
+    (tmp_path / "wip.txt").write_text("wip")
+    _git(tmp_path, "add", "wip.txt").check_returncode()
+    ok, why = mod._sync_upstream(str(tmp_path))
+    assert ok is True and "dirty" in why and "refusing to merge" in why
+    assert "wip.txt" in why  # the dirty file is named
+
+
+def test_sync_upstream_no_upstream_skips(mod, tmp_path):
+    """Neither origin/main nor main exists -> skip. There is no upstream to
+    forward-merge; the warning tells the operator nothing is wrong with the
+    worktree itself."""
+    _init_git(tmp_path, branch="develop")  # initial branch is NOT main
+    # Confirm setup invariants
+    assert _git(tmp_path, "rev-parse", "--verify", "--quiet", "origin/main").returncode != 0
+    assert _git(tmp_path, "rev-parse", "--verify", "--quiet", "main").returncode != 0
+
+    ok, why = mod._sync_upstream(str(tmp_path))
+    assert ok is True and "neither origin/main nor main" in why
+
+
+def test_sync_upstream_falls_back_to_local_main_when_no_origin(mod, tmp_path):
+    """No origin/main -> fall back to a local `main` (offline reproductions and
+    pre-push worktrees still get a forward-merge, just from the local main HEAD
+    instead of origin's)."""
+    _init_git(tmp_path, branch="main")
+    (tmp_path / "from-main.txt").write_text("m")
+    _git(tmp_path, "add", "from-main.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "main commit").check_returncode()
+    # Branch feature from BEFORE main's commit (HEAD~1 = init) so main is AHEAD
+    # of feature — the merge must be a real forward-merge, not an "Already up to
+    # date" no-op (which is what feature-on-top-of-main produces).
+    _git(tmp_path, "checkout", "-q", "HEAD~1").check_returncode()
+    _git(tmp_path, "checkout", "-q", "-b", "feature").check_returncode()
+    (tmp_path / "from-feature.txt").write_text("f")
+    _git(tmp_path, "add", "from-feature.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "feature commit").check_returncode()
+    # No origin remote -> origin/main is unresolvable
+    assert _git(tmp_path, "rev-parse", "--verify", "--quiet", "origin/main").returncode != 0
+    # main still exists as a ref (we branched feature FROM init; main's commit is
+    # still resolvable via the local `main` ref)
+    assert _git(tmp_path, "rev-parse", "--verify", "--quiet", "main").returncode == 0
+
+    ok, why = mod._sync_upstream(str(tmp_path))
+    assert ok is True and "merged main" in why  # local `main`, NOT origin/main
+    assert "Already up to date" not in why  # a real merge happened
+    # Both branches' files exist
+    assert (tmp_path / "from-main.txt").read_text() == "m"
+    assert (tmp_path / "from-feature.txt").read_text() == "f"
+    # Tree is clean (merge committed, no unmerged paths)
+    assert _status_clean(tmp_path)
+
+
+def test_sync_upstream_merges_origin_main_and_preserves_loop_commit(mod, tmp_path):
+    """The kickoff's two invariants in one test: (1) the merge-forward actually
+    lands — main's commits appear in the worktree branch; (2) the loop's own
+    commit SURVIVES — the pre-merge HEAD is still an ancestor of the new HEAD
+    (verified via `git merge-base --is-ancestor`). This is the property that
+    makes `--no-ff` the right choice: both branches' DAG positions are kept."""
+    _init_git(tmp_path, branch="main")
+    # main has a commit ahead of feature
+    (tmp_path / "from-main.txt").write_text("main-content")
+    _git(tmp_path, "add", "from-main.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "main lands a fix").check_returncode()
+    # Spin up a `feature` branch (the deploy target the loop commits onto) with a
+    # non-conflicting change, on top of main's initial state.
+    _git(tmp_path, "checkout", "-q", "-b", "feature").check_returncode()
+    # First rewind feature to before main's commit, so the merge is non-trivial
+    # (origin/main is AHEAD of feature) but non-conflicting (different files).
+    _git(tmp_path, "reset", "--hard", "HEAD~1").check_returncode()
+    (tmp_path / "from-feature.txt").write_text("loop-content")
+    _git(tmp_path, "add", "from-feature.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "loop commits a fix").check_returncode()
+
+    # Spin up a local origin/main so the merge targets origin/main (matches the
+    # production merge command in launch-armed.sh).
+    _git(tmp_path, "branch", "-f", "main", "main").check_returncode()  # ensure main still exists
+    _git(tmp_path, "update-ref", "refs/remotes/origin/main", "main").check_returncode()
+
+    loop_head = _head(tmp_path)  # capture pre-merge: the loop's commit
+    assert _status_clean(tmp_path)
+
+    ok, why = mod._sync_upstream(str(tmp_path))
+    assert ok is True and "merged origin/main" in why
+    assert "preserved as a merge parent" in why  # the exact wording from the impl
+
+    # Both files exist and the merge was real (no fast-forward shadowing the work)
+    assert (tmp_path / "from-main.txt").read_text() == "main-content"
+    assert (tmp_path / "from-feature.txt").read_text() == "loop-content"
+    assert _status_clean(tmp_path)  # committed, no conflict markers
+
+    # The loop's commit survives: loop_head is an ancestor of the post-merge HEAD
+    is_ancestor = _git(tmp_path, "merge-base", "--is-ancestor", loop_head, "HEAD")
+    assert is_ancestor.returncode == 0, (
+        f"loop commit {loop_head} must remain an ancestor of HEAD after the merge"
+    )
+
+    # The HEAD advanced (a merge commit landed) — not a silent no-op
+    new_head = _head(tmp_path)
+    assert new_head != loop_head, "HEAD must advance after a successful forward-merge"
+
+
+def test_sync_upstream_conflict_aborts_and_leaves_head_and_tree_untouched(mod, tmp_path):
+    """The kickoff's hardest invariant: a genuine conflict leaves HEAD and the
+    working tree BYTE-IDENTICAL. We compare pre- and post-sync git state (HEAD
+    sha + `git status --porcelain`), and prove the function returned True with
+    a conflict warning (the restart still proceeds). The merge command MUST NOT
+    use -X ours/theirs (that would fabricate a resolution)."""
+    _init_git(tmp_path, branch="main")
+    (tmp_path / "common.txt").write_text("from main\n")
+    _git(tmp_path, "add", "common.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "main edits common.txt").check_returncode()
+    # Branch feature from BEFORE main's commit (HEAD~1 = init) so main is AHEAD of
+    # feature with a CONFLICTING edit on common.txt. (feature-on-top-of-main
+    # would make the merge a no-op — main is an ancestor of feature, nothing to
+    # merge in, no conflict.)
+    _git(tmp_path, "checkout", "-q", "HEAD~1").check_returncode()
+    _git(tmp_path, "checkout", "-q", "-b", "feature").check_returncode()
+    (tmp_path / "common.txt").write_text("from feature\n")
+    _git(tmp_path, "add", "common.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "feature edits common.txt differently").check_returncode()
+
+    pre_head = _head(tmp_path)
+    assert _status_clean(tmp_path)
+    pre_content = (tmp_path / "common.txt").read_text()
+
+    ok, why = mod._sync_upstream(str(tmp_path))
+
+    # Invariant 1: function returns True — the restart MUST proceed regardless of
+    # the conflict. A blocking sync would wedge the singleton lock.
+    assert ok is True, f"sync must not abort the restart; got {why!r}"
+    # Invariant 2: a conflict warning names what went wrong
+    assert "conflict" in why, f"warning must name the conflict; got {why!r}"
+    # Invariant 3: HEAD is byte-identical — no merge commit landed
+    assert _head(tmp_path) == pre_head, "HEAD must not advance on conflict"
+    # Invariant 4: working tree is byte-identical — no conflict markers, no staged
+    # changes, no untracked files left behind. `git merge --abort` cleans all of
+    # these per git-merge docs.
+    assert _status_clean(tmp_path), "tree must be clean after conflict + abort"
+    # Invariant 5: the file content is the pre-merge feature-branch content
+    # (the abort restored HEAD's version — no `theirs`/`ours` resolution)
+    assert (tmp_path / "common.txt").read_text() == pre_content, (
+        "conflict must not silently resolve; content must be the pre-merge HEAD version"
+    )
+    # Invariant 6: we did NOT use -X ours/theirs — there are no such flags in the
+    # conflict-warning path (impl uses bare `git merge --no-ff --no-edit`)
+    assert "ours" not in why and "theirs" not in why, "the warning must not advertise a fabricated resolution"
+
+
+def test_sync_upstream_is_a_noop_when_main_is_already_merged(mod, tmp_path):
+    """main is already an ancestor of HEAD -> the merge is "Already up to date",
+    HEAD doesn't move, no commit is made. The function still returns True
+    (best-effort); the warning distinguishes this from a real merge so the
+    operator sees the sync had nothing to do (e.g. another worker already
+    forward-merged this exact SHA)."""
+    _init_git(tmp_path, branch="main")
+    (tmp_path / "common.txt").write_text("shared")
+    _git(tmp_path, "add", "common.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "main").check_returncode()
+    _git(tmp_path, "checkout", "-q", "-b", "feature").check_returncode()
+    # feature has a commit ON TOP of main (so main is already feature's ancestor)
+    (tmp_path / "feature-only.txt").write_text("feature")
+    _git(tmp_path, "add", "feature-only.txt").check_returncode()
+    _git(tmp_path, "commit", "-q", "-m", "feature on top").check_returncode()
+
+    pre_head = _head(tmp_path)
+    assert _status_clean(tmp_path)
+
+    ok, why = mod._sync_upstream(str(tmp_path))
+    assert ok is True
+    assert "Already up to date" in why  # explicit no-op signal
+    assert _status_clean(tmp_path)
+    # HEAD did NOT move — the merge had nothing to bring in
+    assert _head(tmp_path) == pre_head, "HEAD must not advance on Already-up-to-date"
+
