+def _recipe_root(root: str) -> str:
+    """Base dir for recipe assets (artifact_contract). main.py resolves a
+    recipe against the MINI_ORK_HOME overlay when a consumer symlinks a
+    private recipe there (MINI_ORK_ROOT still points at the primary checkout)
+    and threads the winning base via MINI_ORK_RECIPE_ROOT. Honor it so every
+    recipe-asset read in this module matches where the recipe was found;
+    absent (dev checkouts), fall back to root unchanged.
+
+    Mirrors ``mini_ork.cli.execute._recipe_root`` and
+    ``mini_ork.cli.execute_handlers._recipe_root`` — duplicated here because
+    ``cli.execute`` imports from this module (cycle), so a shared helper can't
+    live in either place without late-binding indirection.
+    """
+    return os.environ.get("MINI_ORK_RECIPE_ROOT") or root
+
