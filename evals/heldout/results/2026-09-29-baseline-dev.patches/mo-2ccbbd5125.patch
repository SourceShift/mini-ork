+def resolve_home_path(raw: str | Path) -> Path:
+    """Resolve a user-supplied path to its canonical .mini-ork home form.
+
+    Accepts either the project folder (~/ps/researcher) or the home itself
+    (~/ps/researcher/.mini-ork). Prefers <folder>/.mini-ork over a stray
+    state.db at the folder root.
+
+    Idempotent: resolve_home_path(resolve_home_path(p)) == resolve_home_path(p).
+    Does NOT validate that a state.db exists; callers that need to reject
+    invalid paths must follow up with their own check.
+    """
+    home = Path(raw).expanduser().resolve()
+    if (home / ".mini-ork" / "state.db").exists():
+        home = home / ".mini-ork"
+    return home
+
