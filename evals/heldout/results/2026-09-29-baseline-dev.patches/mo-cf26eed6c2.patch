+def _arxiv_canonical(arxiv_id: str) -> str:
+    """Strip an optional trailing version (v1, v2, …) for forgiving comparison.
+
+    LibWit corpus source_ids sometimes keep the version suffix (`arxiv:2604.05112v1`)
+    while report prose refers to the same paper without it (`arxiv:2604.05112`).
+    Normalising both sides avoids flagging a real citation as absent.
+    """
+    return ARXIV_VERSION_SUFFIX.sub("", arxiv_id)
 
 
