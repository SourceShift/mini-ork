+def _recover_lens_json(out_file: str, raw_text: str) -> None:
+    """Recover ``lens-<family>.json`` from captured agent output when missing.
+
+    The researcher handler persists the agent's stdout to ``lens-<family>.md``
+    via :meth:`NodeDispatch.write_preserving_agent`. The chapter-review panel
+    verifier reads the sibling ``lens-<family>.json`` unconditionally; when a
+    lens agent prints its score object instead of writing it with a tool, the
+    .json is absent and the panel fails. This helper mirrors the brace-balanced
+    scanner used in :mod:`gates.rubric_scoring` and :mod:`gates.mutation_adversary`
+    — keyed on ``"lens"`` — to extract the JSON object from the text we already
+    hold. An existing non-empty ``.json`` sibling always wins, so a real
+    tool-write can never be clobbered.
+
+    Fail-soft by design: any error (no lens pattern, unbalanced braces, parse
+    failure, write failure) writes nothing — the node's caller never aborts
+    because of this recovery attempt.
+    """
+    base = os.path.basename(out_file)
+    if not base.startswith("lens-") or not base.endswith(".md"):
+        return
+    family = base[len("lens-"):-len(".md")]
+    if not family:
+        return
+    json_path = os.path.join(os.path.dirname(out_file) or ".", f"lens-{family}.json")
+    try:
+        if os.path.isfile(json_path) and os.path.getsize(json_path) > 0:
+            return  # existing non-empty sibling always wins
+    except OSError:
+        return
+    starts = [m.start() for m in re.finditer(r'\{[^{]*?"lens"\s*:', raw_text)]
+    for start in reversed(starts):
+        depth, in_str, esc = 0, False, False
+        for i in range(start, len(raw_text)):
+            c = raw_text[i]
+            if esc:
+                esc = False
+                continue
+            if c == "\\":
+                esc = True
+                continue
+            if c == '"' and not esc:
+                in_str = not in_str
+                continue
+            if in_str:
+                continue
+            if c == "{":
+                depth += 1
+            elif c == "}":
+                depth -= 1
+                if depth == 0:
+                    cand = raw_text[start:i + 1]
+                    try:
+                        obj = json.loads(cand)
+                    except Exception:
+                        break
+                    try:
+                        with open(json_path, "w", encoding="utf-8") as fh:
+                            json.dump(obj, fh, indent=2)
+                    except OSError:
+                        return
+                    return
+    # Unparseable output writes nothing — fail-soft by design.
+
+
