+def _stamp_and_clear_sidecars(run_dir: str) -> None:
+    """Clear the cost/duration/lane sidecars and stamp .last-llm-node with
+    MO_NODE_ID so a node that dispatched nothing never reads the previous
+    node's cost back as its own. _read_fresh_sidecar returns None on a stamp
+    mismatch; the clear guarantees the value sidecars carry the stamped
+    node's data only. Idempotent — safe to call before every write."""
+    for side in (".last-llm-cost", ".last-llm-duration-ms", ".last-llm-lane"):
+        try:
+            os.remove(os.path.join(run_dir, side))
+        except OSError:
+            pass
+    try:
+        open(os.path.join(run_dir, ".last-llm-node"), "w").write(
+            os.environ.get("MO_NODE_ID", "")
+        )
+    except OSError:
+        pass
+
+
+# `_stamp_and_clear_sidecars` is defined AFTER its first call site above, but
+# Python resolves it at call time — `_write_duration_ms` and `_write_lane_sidecar`
+# are not invoked during module import. The helper keeps the three call sites
+# (this module + dispatch/__main__) byte-identical so a future reader gate can
+# be tightened in one place.
+
+
 if __name__ == "__main__":
     raise SystemExit(llm_dispatch())
