+def _resolve_base(root: str, fallback: str) -> str:
+    """The diff base for THIS child: prefer the child's own pre-implementer
+    ref (the worktree state captured by execute.py before the first implementer
+    edit) so we measure ONLY the child's change, never the goal-loop worker's
+    pre-existing divergence from origin/main (the phantom-red that broke the
+    typecheck on unrelated .ts files). MO_GOAL_SCOPED_BASE remains the
+    fallback when no run dir or ref is on disk, and a non-hex value is
+    rejected so it can never reach git.
+    """
+    run_dir = os.environ.get("MINI_ORK_RUN_DIR", "").strip()
+    if run_dir:
+        try:
+            ref = open(os.path.join(run_dir, "pre-implementer-ref"), encoding="utf-8").read().strip()
+        except OSError:
+            ref = ""
+        if _HEX_RE.match(ref):
+            return ref
+    return fallback
+
