+# Strip operator-session <z-insight> protocol blocks at the render layer.
+# lib/llm-dispatch.sh strips the same shape at write time for new runs;
+# transcripts persisted before that fix still carry the blocks and the
+# UI must never render them.
+_Z_INSIGHT_PAIR_RE = re.compile(r"<z-insight>.*?</z-insight>", re.DOTALL)
+_Z_INSIGHT_TAIL_RE = re.compile(r"<z-insight>.*\Z", re.DOTALL)
+
+
+def _strip_z_insight(text: str | None) -> str | None:
+    """Remove <z-insight>...</z-insight> protocol blocks from rendered text.
+
+    Defensive: returns the input untouched when it is empty or already free
+    of the marker, so the common path stays cheap. Mirrors the sanitizer in
+    lib/llm-dispatch.sh so persisted transcripts and current writes agree.
+    """
+    if not text or "<z-insight>" not in text:
+        return text
+    text = _Z_INSIGHT_PAIR_RE.sub("", text)
+    text = _Z_INSIGHT_TAIL_RE.sub("", text)
+    return text.rstrip()
+
 
