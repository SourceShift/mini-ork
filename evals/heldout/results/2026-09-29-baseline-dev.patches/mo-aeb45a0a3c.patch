+        ["u1", "u2"],
+        unit_reasons={
+            "u1": {"status": "fail", "failing_node": "W9",
+                   "reasons": ["W9 failed"]},
+            "u2": {"status": "fail", "failing_node": "W12",
+                   "reasons": ["W12 failed"]},
+        },
+    )
+    sig_w15 = _LOOP_STATE.wave_signature(
+        ["u1", "u2"],
+        unit_reasons={
+            "u1": {"status": "fail", "failing_node": "W15",
+                   "reasons": ["W15 failed"]},
+            "u2": {"status": "fail", "failing_node": "W12",
+                   "reasons": ["W12 failed"]},
+        },
+    )
+    assert sig_w9 != sig_w15
+
+
+def test_wave_signature_backward_compat_reasons_none():
+    """``wave_signature(failing_units)`` (no unit_reasons) is byte-for-byte
+    identical to the pre-fingerprint implementation — the kickoff's
+    ``reasons=None reproduces the historical set-only signature`` contract."""
+    import hashlib
+    expected = hashlib.sha256()
+    for unit in sorted(["u1", "u2"]):
+        expected.update(unit.encode("utf-8"))
+        expected.update(b"\x00")
+    assert _LOOP_STATE.wave_signature(["u1", "u2"]) == expected.hexdigest()
+
+
+# ── 12. divergence() honors the patience window ─────────────────────────
+#   The book launcher raises MO_GOAL_DIVERGENCE_PATIENCE to 6 so a code-fix
+#   child gets several waves to land a real researcher fix before the loop
+#   declares no_progress. Patience=2 is the historical default that preserves
+#   the all-units-per-wave contract.
+
+
+def test_divergence_patience_window_three_waves(tmp_path, monkeypatch):
+    """patience=3: two identical signatures do NOT trip; the third does."""
+    monkeypatch.setenv("MO_GOAL_DIVERGENCE_PATIENCE", "3")
+    state_dir = tmp_path / "state"
+
+    def run_wave(wave_no, quarantined):
+        return {
+            "verdict": "fail",
+            "failing_after": ["u1"],
+            "attempted": ["u1"],
+            "unit_reasons": {"u1": {"status": "fail", "failing_node": "W9",
+                                    "reasons": ["W9 failed"]}},
+            "cost_usd": 1.0,
+            "run_id": f"r{wave_no}",
+        }
+
+    verdict = drive(
+        goal_id="g-pat-3", target_cwd="/tmp",
+        units_cmd="echo u", predicate_cmd="echo ok", child_recipe="code-fix",
+        max_waves=10, budget_total_usd=100.0,
+        run_wave_fn=run_wave, cost_fn=lambda: 0.0, state_dir=state_dir,
+    )
+
+    assert verdict["stop"] == "diverged"
+    assert verdict["waves"] == 3, "patience=3 must let 2 identical sigs through"
+
+
+# ── 13. record_wave scopes quarantine hashing to ATTEMPTED units ─────────
+#   Without this, MAX_CHILDREN_PER_WAVE=1 over 10 chapters accrues the same
+#   hash for every surviving unit by wave 2 and trips all_quarantined next
+#   (the kickoff's "GRAO quarantine was degenerate" finding).
+
+
+def test_record_wave_attempted_scoped_hashing():
+    """``attempted=[]`` means nothing was dispatched this wave; even if a unit
+    remains in failing_after, it must NOT accrue a quarantine hash."""
+    state = _LOOP_STATE.load_state(_tmp_empty_dir(), "g-attempt")
+
+    _LOOP_STATE.record_wave(
+        state,
+        wave=1, run_id="r1",
+        failing_before=["u_pending"],
+        failing_after=["u_pending"],  # never attempted
+        cost_usd=0.0,
+        attempted=[],
+        unit_reasons={},
+    )
+    assert "u_pending" not in state["failed_fixes"], (
+        "pending unit must not accrue hashes when attempted=[]"
+    )
+
+
+def _tmp_empty_dir():
+    """Lazily mint a fresh tmp dir per call — used only by hash-scope tests
+    that don't exercise persistence."""
+    import tempfile
+    return Path(tempfile.mkdtemp(prefix="loop-state-test-"))
+
+
+# ── 14. drive() integration: book loop survives to wave 4 and lands ──────
+#   Simulates MAX_CHILDREN_PER_WAVE=1 over 10 chapters. The single child
+#   moves the failure W9 → W15 (real progress) before clearing it on the
+#   third attempt. With fingerprints the outer loop sees that movement as
+#   a signature change; with set-only signatures it would have tripped
+#   no_progress at wave 2.
+
+
+def test_book_loop_survives_to_wave_4_and_lands(tmp_path):
+    state_dir = tmp_path / "state"
+    pending = [f"ch{i:02d}" for i in range(1, 10)]  # 9 chapters still pending
+    waves_run: list[int] = []
+
+    # Per-wave fingerprint for the hunted chapter. Moved failure between
+    # waves 1 → 2; cleared on wave 3 → goal_met on wave 4.
+    fingerprints = {
+        1: {"ch00": {"status": "fail", "failing_node": "W9",
+                     "reasons": ["W9 failed mdlen=1200"]}},
+        2: {"ch00": {"status": "fail", "failing_node": "W15",
+                     "reasons": ["W15 failed mdlen=850"]}},
+        3: {"ch00": {"status": "fail", "failing_node": "W9",
+                     "reasons": ["W9 failed mdlen=1100"]}},
+    }
+
+    def run_wave(wave_no, quarantined):
+        waves_run.append(wave_no)
+        if wave_no <= 3:
+            return {
+                "verdict": "fail",
+                "failing_after": ["ch00"] + pending,
+                "attempted": ["ch00"],
+                "unit_reasons": fingerprints[wave_no],
+                "cost_usd": 1.0,
+                "run_id": f"r{wave_no}",
+            }
+        return {"verdict": "pass", "failing_after": [], "cost_usd": 1.0,
+                "run_id": "r4"}
+
+    verdict = drive(
+        goal_id="g-book-loop", target_cwd="/tmp",
+        units_cmd="echo u", predicate_cmd="echo ok", child_recipe="code-fix",
+        max_waves=10, budget_total_usd=100.0,
+        run_wave_fn=run_wave, cost_fn=lambda: 0.0, state_dir=state_dir,
+    )
+
+    assert verdict["stop"] == "goal_met"
+    assert waves_run == [1, 2, 3, 4], (
+        "the loop must NOT trip no_progress at wave 2 when the failure "
+        "moves W9 → W15; pending chapters must not spuriously trip "
+        "all_quarantined."
+    )
+
+
+# ── 15. drive() integration: book loop still diverges at the window ──────
+#   Sanity check: patience=3 must NOT mask genuine stuckness. Three waves
+#   of IDENTICAL fingerprint still trips no_progress — at wave 3, not 2.
+
+
+def test_book_loop_diverges_at_window_not_before(tmp_path, monkeypatch):
+    monkeypatch.setenv("MO_GOAL_DIVERGENCE_PATIENCE", "3")
+    state_dir = tmp_path / "state"
+    waves_run: list[int] = []
+
+    def run_wave(wave_no, quarantined):
+        waves_run.append(wave_no)
+        return {
+            "verdict": "fail",
+            "failing_after": ["u1"],
+            "attempted": ["u1"],
+            "unit_reasons": {"u1": {"status": "fail", "failing_node": "W9",
+                                    "reasons": ["W9 failed"]}},
+            "cost_usd": 1.0,
+            "run_id": f"r{wave_no}",
+        }
+
+    verdict = drive(
+        goal_id="g-div-window", target_cwd="/tmp",
+        units_cmd="echo u", predicate_cmd="echo ok", child_recipe="code-fix",
+        max_waves=10, budget_total_usd=100.0,
+        run_wave_fn=run_wave, cost_fn=lambda: 0.0, state_dir=state_dir,
+    )
+
+    assert verdict["stop"] == "diverged"
+    assert verdict["waves"] == 3, (
+        "patience=3 must let the 1st and 2nd identical sigs through "
+        "and fire no_progress on the 3rd"
+    )
+
+
+# ── 16. drive() integration: pending units never trip all_quarantined ─────
+#   u_pending lives in failing_after every wave (the single-child loop
+#   never reaches it). Without attempted-scoped hashing, after 2 waves the
+#   identical unit_id hash would mark it quarantined and the next wave's
+#   all_quarantined check would fire spuriously.
+
+
+def test_pending_unit_never_trips_all_quarantined(tmp_path):
+    state_dir = tmp_path / "state"
+    waves_run: list[int] = []
+
+    def run_wave(wave_no, quarantined):
+        waves_run.append(wave_no)
+        # Wave 1+2: u1 hunted (fingerprint changes — loop should keep going).
+        # u_pending never attempted; sits in failing_after every wave.
+        # Wave 3+: u1 cleared → only u_pending remains, never quarantined.
+        if wave_no <= 2:
+            return {
+                "verdict": "fail",
+                "failing_after": ["u1", "u_pending"],
+                "attempted": ["u1"],
+                "unit_reasons": {
+                    "u1": {"status": "fail", "failing_node": "W9"
+                           if wave_no == 1 else "W15",
+                           "reasons": ["moved"]},
+                },
+                "cost_usd": 1.0,
+                "run_id": f"r{wave_no}",
+            }
+        # Wave 3+: u1 cleared, only u_pending remains, nothing to attempt.
+        return {
+            "verdict": "fail",
+            "failing_after": ["u_pending"],
+            "attempted": [],
+            "unit_reasons": {},
+            "cost_usd": 1.0,
+            "run_id": f"r{wave_no}",
+        }
+
+    verdict = drive(
+        goal_id="g-pending", target_cwd="/tmp",
+        units_cmd="echo u", predicate_cmd="echo ok", child_recipe="code-fix",
+        max_waves=10, budget_total_usd=100.0,
+        run_wave_fn=run_wave, cost_fn=lambda: 0.0, state_dir=state_dir,
+    )
+
+    assert "u_pending" not in verdict["quarantined_units"], (
+        "u_pending must never be quarantined — it was never attempted, so "
+        "no quarantine hash was ever recorded for it"
+    )
+    # The KEY invariant: all_quarantined must NOT fire spuriously on a
+    # pending unit (the historical failure mode this fix exists to prevent).
+    assert verdict["stop"] != "all_quarantined", (
+        "all_quarantined must not fire when the pending unit was never "
+        "attempted — it has no quarantine history by construction"
+    )
+    # u1 (the hunted chapter) did produce a stable fingerprint across waves
+    # 3+ where only u_pending remains, so the loop correctly trips
+    # 'diverged' or 'max_waves_reached' — both are acceptable signals that
+    # the loop noticed the stuckness without falsely quarantining u_pending.
