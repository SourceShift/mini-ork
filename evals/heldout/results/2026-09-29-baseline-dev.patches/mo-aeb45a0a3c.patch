+def _parse_unit_reasons_from_goal_state(path: Path) -> dict[str, dict[str, Any]]:
+    """Parse ``<run_dir>/goal-state.json`` into the unit-fingerprint shape.
+
+    The wave's ``goal_state`` transform writes ``{unit_id: {"pass": bool, "reason":
+    str}}``. We map that into ``{unit_id: {"status": "pass"|"fail", "failing_node":
+    str, "reasons": [str]}}`` so :func:`wave_signature` and :func:`record_wave`
+    can fold per-unit progress (status + failing node + volatile-stripped reasons).
+
+    A ``failing_node`` is extracted from the reason text when present (either
+    via a literal ``node=<id>`` / ``failing_node=<id>`` token, or by taking the
+    first whitespace-delimited token — most production reasons look like
+    ``"W9 failed because ..."``). When the reason carries no node hint, the
+    fingerprint's ``failing_node`` is the empty string and the signature falls
+    back to status + reasons. Unparseable / missing files yield an empty dict,
+    which preserves the historical signature (unit-set only) for callers.
+    """
+    if not path.is_file():
+        return {}
+    try:
+        raw = json.loads(path.read_text(encoding="utf-8"))
+    except json.JSONDecodeError:
+        return {}
+    if not isinstance(raw, dict):
+        return {}
+
+    # Local copy of the regexes (loop_state has them too; we don't import to
+    # keep drive.py hermetic under ``python3 drive.py`` no-args invocation).
+    _node_pat = re.compile(r"\b(?:node|failing_node)=([\w.\-]+)")
+    _volatile_pat = re.compile(r"\b(?:attempts?|mdlen)=\d+\b")
+    _ws_pat = re.compile(r"\s+")
+
+    def _clean(reason: str) -> str:
+        return _ws_pat.sub(" ", _volatile_pat.sub("", reason or "")).strip()
+
+    def _node(reason: str) -> str:
+        m = _node_pat.search(reason or "")
+        if m:
+            return m.group(1)
+        # First whitespace-delimited token — empty if reason is empty.
+        tokens = (reason or "").split()
+        return tokens[0] if tokens else ""
+
+    out: dict[str, dict[str, Any]] = {}
+    for unit_id, state in raw.items():
+        if not isinstance(state, dict):
+            continue
+        is_pass = bool(state.get("pass"))
+        reason_text = str(state.get("reason", "") or "")
+        out[str(unit_id)] = {
+            "status": "pass" if is_pass else "fail",
+            "failing_node": "" if is_pass else _node(reason_text),
+            "reasons": [_clean(reason_text)] if reason_text else [],
+        }
+    return out
+
+
+def _parse_attempted_from_sweep_result(path: Path) -> list[str]:
+    """Parse ``<run_dir>/sweep-result.json`` into the list of attempted unit ids.
+
+    The wave's ``sweep`` node writes ``{"units": [{"unit_id": ..., "status":
+    ...}, ...]}``. ``attempted`` is the subset that were ACTUALLY dispatched
+    (``status in {"spawned", "failed"}``); ``deferred`` / ``dry_run`` units
+    were capped out by the parallel budget and must not accrue quarantine
+    hashes for failures the loop never tried to fix.
+    """
+    if not path.is_file():
+        return []
+    try:
+        raw = json.loads(path.read_text(encoding="utf-8"))
+    except json.JSONDecodeError:
+        return []
+    if not isinstance(raw, dict):
+        return []
+    units = raw.get("units") or []
+    if not isinstance(units, list):
+        return []
+    return [
+        str(u.get("unit_id"))
+        for u in units
+        if isinstance(u, dict) and u.get("status") in {"spawned", "failed"}
+    ]
+
