+def test_resolve_lane_model_empty_home_root_does_not_hit_cwd(tmp_path, monkeypatch):
+    """RATCHET: empty home/root must NOT silently resolve config/agents.yaml
+    against the process CWD. Old behaviour joined '' into 'config/agents.yaml'
+    and isfile'd it against CWD, so an implementer alias would silently map to
+    'sonnet' from the repo-default agents.yaml — indistinguishable from a
+    hit. New behaviour: a clean miss falls through to the 'sonnet' default
+    without consulting the CWD's agents.yaml at all."""
+    cwd_agents = tmp_path / "config"
+    cwd_agents.mkdir()
+    (cwd_agents / "agents.yaml").write_text("lanes:\n  implementer: kimi\n  planner: opus\n")
+    monkeypatch.chdir(tmp_path)
+    # Old buggy code: 'config/agents.yaml' resolves against tmp_path → returns 'kimi'.
+    # New code: empty home/root → joins to '' → isfile('') is False → 'sonnet' fallback.
+    assert ld.resolve_lane_model("implementer", root="", home="") == "sonnet"
+    assert ld.resolve_lane_model("planner", root="", home="") == "sonnet"
+
