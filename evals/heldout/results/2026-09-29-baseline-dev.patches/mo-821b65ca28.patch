+def test_empty_home_and_root_does_not_resolve_against_cwd(tmp_path, monkeypatch):
+    """RATCHET: an empty MINI_ORK_HOME/ROOT must NOT silently resolve
+    config/agents.yaml against the process CWD. Old behaviour: os.path.join
+    with home='' produced 'config/agents.yaml', which os.path.isfile then
+    checked against CWD — masking a miss as a hit when the repo (with its
+    default config/agents.yaml) was checked out there. New behaviour: a
+    clean miss returns the lane unchanged."""
+    # Plant a CWD-relative config/agents.yaml that the OLD code would pick up.
+    cwd_agents = tmp_path / "config"
+    cwd_agents.mkdir()
+    (cwd_agents / "agents.yaml").write_text(textwrap.dedent("""
+        lanes:
+          codex_lens: codex
+          implementer: sonnet
+    """))
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.delenv("MINI_ORK_HOME", raising=False)
+    monkeypatch.delenv("MINI_ORK_ROOT", raising=False)
+    # Env unset: clean miss — lane unchanged because no policy was pinned.
+    assert resolve_lane_family("codex_lens") == "codex_lens"
+    assert resolve_lane_family("implementer") == "implementer"
+    # Explicit empty kwargs are likewise a clean miss.
+    assert resolve_lane_family("codex_lens", root="", home="") == "codex_lens"
