diff --git a/tests/unit/test_execute_gate_check_py.py b/tests/unit/test_execute_gate_check_py.py
new file mode 100644
index 00000000..4f2dc1f2
--- /dev/null
+++ b/tests/unit/test_execute_gate_check_py.py
@@ -0,0 +1,407 @@
+"""Native section-4 coverage for the execute pre-dispatch gate.
+
+Regression test for the BLOCKED→ESCALATE fix (mo-9872a9a570). The bash oracle
+test_dispatch_telemetry_gate.sh section 4 was the original home of this check;
+its hand-rolled minimal CREATE TABLE masked the production CHECK constraint, so
+the gate happily wrote verdict='BLOCKED' under the oracle while production
+would have rejected it with IntegrityError — and the swallowed
+``except sqlite3.Error: pass`` in ``_execute_gate_check`` rolled the audit
+trail back silently (exit 6 with nothing recorded).
+
+This native port seeds the DB via the real ``bash db/init.sh`` so the actual
+production CHECK is in place. Any future regression that re-introduces a
+non-schema-valid verdict value will fail here loudly:
+
+  - ``test_gate_blocks_escalate_writes_schema_valid_verdict``
+      Direct _execute_gate_check call against the seeded DB. Asserts the row
+      lands as status=failed, verdict='ESCALATE' (the schema-valid choice), the
+      execute_blocked run_event is recorded, and blocked.json carries the gate
+      info.
+
+  - ``test_gate_exits_6_via_mini_ork_execute_subprocess``
+      End-to-end: invokes ``bin/mini-ork execute`` on a needs_answers plan and
+      asserts the bash-oracle-identical rc + DB shape (status=failed,
+      verdict='ESCALATE, execute_blocked event, blocked.json). Mirrors
+      test_dispatch_telemetry_gate.sh section 4 one-for-one.
+
+  - ``test_schema_rejects_blocked_verdict_directly``
+      Sentinel: a direct UPDATE that writes verdict='BLOCKED' against the
+      seeded DB must raise sqlite3.IntegrityError. If this ever passes the
+      constraint has been weakened and the gate needs a new test.
+
+  - ``test_execute_gate_env_bypass_skips_gate``
+      ``MINI_ORK_EXECUTE_GATE=0`` skips the gate entirely. The plan is a normal
+      plan with no decomposition (so dispatch is a no-op under dry-run) and
+      rc=0.
+
+  - ``test_non_needs_answers_plan_not_gated``
+      ``plan_status=planned`` with no human_questions must NOT trigger the
+      gate — the row is left as-is (status=planned, verdict=NULL), no
+      blocked.json, no execute_blocked event. The gate's empty-questions /
+      wrong-status guard fires.
+
+Plus a small module-imports-clean test so any future rename of
+``_execute_gate_check`` surfaces a clear ``ImportError`` rather than a
+``AttributeError`` mid-test.
+
+Why this lives in tests/unit/ (not tests/integration/): the bash subprocess
+test_dispatch_telemetry_gate.sh already covers the full CLI flow. The native
+port exists to PROVE the production CHECK is in play and the gate's verdict
+choice is schema-valid, which a hand-rolled DDL cannot do.
+"""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import sqlite3
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO))
+
+from mini_ork.ported.mini_ork_execute import _execute_gate_check  # noqa: E402
+
+DB_INIT = REPO / "db" / "init.sh"
+BIN_MINI_ORK = REPO / "bin" / "mini-ork"
+
+
+def _which_bash() -> None:
+    if not shutil.which("bash"):
+        pytest.skip("bash not on PATH")
+    if not shutil.which("sqlite3"):
+        pytest.skip("sqlite3 not on PATH (required by db/init.sh)")
+    if not DB_INIT.exists():
+        pytest.skip(f"missing db/init.sh at {DB_INIT}")
+    if not BIN_MINI_ORK.exists():
+        pytest.skip(f"missing bin/mini-ork at {BIN_MINI_ORK}")
+
+
+def _seed_db(db_path: Path) -> None:
+    """Run ``bash db/init.sh`` so the seeded DB carries the production
+    task_runs CHECK constraint (the whole point of this test)."""
+    env = {**os.environ, "MINI_ORK_DB": str(db_path)}
+    r = subprocess.run(
+        ["bash", str(DB_INIT)],
+        env=env,
+        cwd=str(REPO),
+        capture_output=True,
+        text=True,
+    )
+    assert r.returncode == 0, (
+        f"db/init.sh failed rc={r.returncode}\nstdout={r.stdout}\nstderr={r.stderr}"
+    )
+    # Belt-and-braces: confirm the production CHECK landed.
+    con = sqlite3.connect(str(db_path))
+    try:
+        row = con.execute(
+            "SELECT sql FROM sqlite_master WHERE type='table' AND name='task_runs'"
+        ).fetchone()
+    finally:
+        con.close()
+    assert row and row[0], "task_runs table missing after db/init.sh"
+    assert "ESCALATE" in row[0], (
+        f"production verdict CHECK missing from task_runs DDL: {row[0]!r}"
+    )
+    assert "APPROVE" in row[0] and "REQUEST_CHANGES" in row[0] and "CRASH" in row[0], (
+        f"task_runs verdict CHECK is incomplete: {row[0]!r}"
+    )
+
+
+def _insert_task_run(db_path: Path, run_id: str = "run-gate",
+                      status: str = "planned",
+                      verdict: str | None = None) -> None:
+    con = sqlite3.connect(str(db_path))
+    try:
+        con.execute(
+            "INSERT INTO task_runs(id, status, task_class, created_at, "
+            "kickoff_path, updated_at, verdict) "
+            "VALUES(?, ?, 'code_fix', strftime('%s','now'), 'k.md', "
+            "strftime('%s','now'), ?)",
+            (run_id, status, verdict),
+        )
+        con.commit()
+    finally:
+        con.close()
+
+
+def _write_plan(run_dir: Path, *, status: str = "needs_answers",
+                 questions: list[str] | None = None,
+                 blocked_by: str = "run_profile") -> None:
+    payload = {
+        "plan_status": status,
+        "blocked_by": blocked_by,
+        "human_questions": questions or [],
+        "decomposition": [],
+    }
+    run_dir.mkdir(parents=True, exist_ok=True)
+    (run_dir / "plan.json").write_text(json.dumps(payload) + "\n")
+
+
+def _row(db_path: Path, run_id: str) -> tuple | None:
+    con = sqlite3.connect(str(db_path))
+    try:
+        return con.execute(
+            "SELECT status, verdict FROM task_runs WHERE id=?", (run_id,)
+        ).fetchone()
+    finally:
+        con.close()
+
+
+def _event_count(db_path: Path, event_type: str, run_id: str) -> int:
+    con = sqlite3.connect(str(db_path))
+    try:
+        return con.execute(
+            "SELECT count(*) FROM run_events WHERE event_type=? AND run_id=?",
+            (event_type, run_id),
+        ).fetchone()[0]
+    finally:
+        con.close()
+
+
+# ── tests ──────────────────────────────────────────────────────────────────
+
+
+def test_module_imports_clean():
+    """_execute_gate_check must be importable by name from the native module —
+    if it ever gets renamed, this test surfaces a clear ImportError rather
+    than an AttributeError from a mid-test call site."""
+    assert callable(_execute_gate_check)
+
+
+def test_schema_rejects_blocked_verdict_directly(tmp_path):
+    """Sentinel: the production CHECK must reject 'BLOCKED' on the live DB.
+    If this ever passes, the constraint has been weakened and the gate's
+    historical regression could return unnoticed."""
+    _which_bash()
+    db = tmp_path / "state.db"
+    _seed_db(db)
+    _insert_task_run(db, run_id="r1")
+    con = sqlite3.connect(str(db))
+    try:
+        with pytest.raises(sqlite3.IntegrityError):
+            con.execute(
+                "UPDATE task_runs SET verdict='BLOCKED' WHERE id='r1'"
+            )
+    finally:
+        con.close()
+
+
+def test_gate_blocks_escalate_writes_schema_valid_verdict(tmp_path):
+    """Direct _execute_gate_check against the production schema: BLOCKED is
+    gone, ESCALATE is in. The audit trail (status=failed, verdict=ESCALATE,
+    execute_blocked event, blocked.json) is intact."""
+    _which_bash()
+    db = tmp_path / "state.db"
+    home = tmp_path / "home"
+    run_dir = home / "runs" / "run-gate"
+    _seed_db(db)
+    _insert_task_run(db)
+    _write_plan(run_dir, questions=["q1"])
+
+    env = {**os.environ,
+           "MINI_ORK_DB": str(db),
+           "MINI_ORK_HOME": str(home),
+           "MINI_ORK_RUN_ID": "run-gate",
+           "MINI_ORK_DRY_RUN": "0"}
+    # Patch the env only for the duration of the call.
+    snapshot = dict(os.environ)
+    try:
+        os.environ.update(env)
+        blocked = _execute_gate_check(str(run_dir / "plan.json"),
+                                       str(run_dir), dry_run=False)
+    finally:
+        os.environ.clear()
+        os.environ.update(snapshot)
+
+    assert blocked is True, "gate should refuse a needs_answers plan"
+
+    status, verdict = _row(db, "run-gate")
+    assert status == "failed", f"task_runs.status={status!r}, want 'failed'"
+    assert verdict == "ESCALATE", (
+        f"task_runs.verdict={verdict!r}, want 'ESCALATE' "
+        "(the schema-valid choice — BLOCKED violates the production CHECK)"
+    )
+
+    assert _event_count(db, "execute_blocked", "run-gate") == 1
+
+    blocked_json = run_dir / "blocked.json"
+    assert blocked_json.is_file(), "blocked.json missing"
+    info = json.loads(blocked_json.read_text())
+    assert info["plan_status"] == "needs_answers"
+    assert info["blocked_by"] == "run_profile"
+    assert info["human_questions"] == ["q1"]
+
+
+def test_gate_does_not_overwrite_existing_verdict(tmp_path):
+    """A pre-existing verdict (set by an upstream gate) must be preserved —
+    the COALESCE pattern protects in-flight state. This guards against a
+    regression where a 'fix' replaces COALESCE with a literal 'ESCALATE'
+    and clobbers an APPROVE/REQUEST_CHANGES that the planner already
+    recorded."""
+    _which_bash()
+    db = tmp_path / "state.db"
+    home = tmp_path / "home"
+    run_dir = home / "runs" / "run-gate"
+    _seed_db(db)
+    _insert_task_run(db, verdict="REQUEST_CHANGES")
+    _write_plan(run_dir, questions=["q1"])
+
+    env = {**os.environ,
+           "MINI_ORK_DB": str(db),
+           "MINI_ORK_HOME": str(home),
+           "MINI_ORK_RUN_ID": "run-gate",
+           "MINI_ORK_DRY_RUN": "0"}
+    snapshot = dict(os.environ)
+    try:
+        os.environ.update(env)
+        _execute_gate_check(str(run_dir / "plan.json"), str(run_dir),
+                            dry_run=False)
+    finally:
+        os.environ.clear()
+        os.environ.update(snapshot)
+
+    _, verdict = _row(db, "run-gate")
+    assert verdict == "REQUEST_CHANGES", (
+        f"pre-existing verdict was clobbered to {verdict!r}; "
+        "COALESCE preservation regressed"
+    )
+
+
+def test_gate_exits_6_via_mini_ork_execute_subprocess(tmp_path):
+    """End-to-end: invoke ``bin/mini-ork execute`` on a needs_answers plan,
+    assert the bash-oracle-identical outcome. This is the native mirror of
+    tests/integration/test_dispatch_telemetry_gate.sh section 4 — same
+    fixture shape, same assertions, but seeded from db/init.sh so the
+    production CHECK is in play."""
+    _which_bash()
+    db = tmp_path / "state.db"
+    home = tmp_path / "home"
+    run_dir = home / "runs" / "run-gate"
+    _seed_db(db)
+    _insert_task_run(db)
+    _write_plan(run_dir, questions=["q1"])
+
+    # The shipped bin/mini-ork uses an in-process `import` that requires the
+    # mini_ork package on sys.path; sys.path manipulation in the test process
+    # does NOT propagate. Also, the parent process inherits an ambient
+    # MINI_ORK_ENGINE_ROOT (and a stale MINI_ORK_RECIPE, MINI_ORK_WORKFLOW,
+    # etc.) that point at a different checkout — bin/mini-ork trusts those
+    # variables and resolves the engine root from them. We MUST override them
+    # (plus PYTHONPATH) so the subprocess boots in THIS worktree. We
+    # explicitly leave MINI_ORK_PLAN_PATH unset because mini_ork_execute.main
+    # treats it as a pre-set plan_path and rejects the positional plan.json
+    # as "Unexpected argument" (which the bash oracle never hits because the
+    # bash subprocess doesn't carry the python env pin).
+    env = {**os.environ,
+           "MINI_ORK_ENGINE_ROOT": str(REPO),
+           "MINI_ORK_ROOT": str(REPO),
+           "MINI_ORK_DB": str(db),
+           "MINI_ORK_HOME": str(home),
+           "MINI_ORK_RUN_ID": "run-gate",
+           "MINI_ORK_RUN_DIR": str(run_dir),
+           "MINI_ORK_DRY_RUN": "0",
+           "MINI_ORK_PLAN_PATH": "",
+           # Clear recipe / workflow pins so the executor picks the canonical
+           # execute path; the bash oracle doesn't set them.
+           "MINI_ORK_RECIPE": "",
+           "MINI_ORK_WORKFLOW": "",
+           "PYTHONPATH": str(REPO) + os.pathsep + os.environ.get("PYTHONPATH", "")}
+    r = subprocess.run(
+        ["python3", str(BIN_MINI_ORK), "execute", str(run_dir / "plan.json")],
+        env=env,
+        cwd=str(REPO),
+        capture_output=True,
+        text=True,
+    )
+    assert r.returncode == 6, (
+        f"gate rc={r.returncode}, want 6\nstdout={r.stdout}\nstderr={r.stderr}"
+    )
+
+    status, verdict = _row(db, "run-gate")
+    assert status == "failed"
+    assert verdict == "ESCALATE"
+    assert _event_count(db, "execute_blocked", "run-gate") == 1
+    assert (run_dir / "blocked.json").is_file()
+
+
+def test_execute_gate_env_bypass_skips_gate(tmp_path):
+    """``MINI_ORK_EXECUTE_GATE=0`` lets the plan through (under --dry-run so
+    nothing actually dispatches). Mirrors the bash oracle's override assertion."""
+    _which_bash()
+    db = tmp_path / "state.db"
+    home = tmp_path / "home"
+    run_dir = home / "runs" / "run-gate"
+    _seed_db(db)
+    _insert_task_run(db)
+    _write_plan(run_dir, questions=["q1"])
+
+    env = {**os.environ,
+           "MINI_ORK_ENGINE_ROOT": str(REPO),
+           "MINI_ORK_ROOT": str(REPO),
+           "MINI_ORK_DB": str(db),
+           "MINI_ORK_HOME": str(home),
+           "MINI_ORK_RUN_ID": "run-gate",
+           "MINI_ORK_RUN_DIR": str(run_dir),
+           "MINI_ORK_DRY_RUN": "0",
+           "MINI_ORK_EXECUTE_GATE": "0",
+           "MINI_ORK_PLAN_PATH": "",
+           "MINI_ORK_RECIPE": "",
+           "MINI_ORK_WORKFLOW": "",
+           "PYTHONPATH": str(REPO) + os.pathsep + os.environ.get("PYTHONPATH", "")}
+    r = subprocess.run(
+        ["python3", str(BIN_MINI_ORK), "execute", str(run_dir / "plan.json"),
+         "--dry-run"],
+        env=env,
+        cwd=str(REPO),
+        capture_output=True,
+        text=True,
+    )
+    assert r.returncode == 0, (
+        f"gate override broken: rc={r.returncode}\n"
+        f"stdout={r.stdout}\nstderr={r.stderr}"
+    )
+    # No execute_blocked event, no blocked.json — the gate skipped.
+    assert _event_count(db, "execute_blocked", "run-gate") == 0
+    assert not (run_dir / "blocked.json").exists()
+    # The row is untouched (still 'planned', verdict NULL).
+    status, verdict = _row(db, "run-gate")
+    assert status == "planned"
+    assert verdict is None
+
+
+def test_non_needs_answers_plan_not_gated(tmp_path):
+    """A normal plan (status=planned, no human_questions) must NOT trigger
+    the gate. Empty-questions / wrong-status guard."""
+    _which_bash()
+    db = tmp_path / "state.db"
+    home = tmp_path / "home"
+    run_dir = home / "runs" / "run-gate"
+    _seed_db(db)
+    _insert_task_run(db)
+    _write_plan(run_dir, status="planned", questions=[])
+
+    env = {**os.environ,
+           "MINI_ORK_DB": str(db),
+           "MINI_ORK_HOME": str(home),
+           "MINI_ORK_RUN_ID": "run-gate",
+           "MINI_ORK_DRY_RUN": "0"}
+    snapshot = dict(os.environ)
+    try:
+        os.environ.update(env)
+        blocked = _execute_gate_check(str(run_dir / "plan.json"),
+                                       str(run_dir), dry_run=False)
+    finally:
+        os.environ.clear()
+        os.environ.update(snapshot)
+
+    assert blocked is False, "gate should NOT fire on a non-needs_answers plan"
+    status, verdict = _row(db, "run-gate")
+    assert status == "planned", f"row was mutated: status={status!r}"
+    assert verdict is None, f"row was mutated: verdict={verdict!r}"
+    assert _event_count(db, "execute_blocked", "run-gate") == 0
+    assert not (run_dir / "blocked.json").exists()
