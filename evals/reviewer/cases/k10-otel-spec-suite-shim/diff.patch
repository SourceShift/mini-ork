+def _in_spec_test() -> bool:
+    """True while a run's blind ``spec-tests/`` suite is executing.
+
+    ``PYTEST_CURRENT_TEST`` carries only the nodeid (relative to the spec dir),
+    so the calling frame's file is the reliable signal: the spec suite always
+    lives under a ``spec-tests/`` directory.
+    """
+    if any(m in os.environ.get("PYTEST_CURRENT_TEST", "") for m in _SPEC_DIR_MARKERS):
+        return True
+    frame = sys._getframe(1)
+    for _ in range(8):
+        if frame is None:
+            return False
+        filename = frame.f_code.co_filename
+        if any(m in filename for m in _SPEC_DIR_MARKERS):
+            return True
+        frame = frame.f_back
