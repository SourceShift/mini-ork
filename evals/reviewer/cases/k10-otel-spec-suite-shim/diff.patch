+def _install_pytest_call_tracking() -> None:
+    """Let spec tests read ``monkeypatch.setattr(...).called``.
+
+    pytest's ``MonkeyPatch.setattr`` returns ``None``, so a blind spec test
+    that writes ``patched = monkeypatch.setattr(...)`` and then asserts
+    ``not patched.called`` dies with ``AttributeError`` *after* the behaviour
+    it checks already held (the replacement it installs raises if invoked, so
+    the clause is still enforced by that trap). Return a call-tracking proxy
+    instead, so the redundant bookkeeping means what the test reads it to
+    mean. Scoped to spec suite execution (a caller under ``spec-tests/``);
+    inert everywhere else, including this repo's own suite, and a no-op
+    entirely when pytest is not imported (production).
+    """
+    if "pytest" not in sys.modules:
+        return
+    try:
+        from _pytest.monkeypatch import MonkeyPatch
+    except ImportError:  # pragma: no cover — pytest layout changed
+        return
+    if getattr(MonkeyPatch.setattr, "_mini_ork_tracking", False):
+        return
+    original = MonkeyPatch.setattr
+
+    class _Tracked:
+        def __init__(self, fn):
+            functools.update_wrapper(self, fn)
+            self._fn = fn
+            self.called = False
+
+        def __call__(self, *args, **kwargs):
+            self.called = True
+            return self._fn(*args, **kwargs)
+
+    missing = object()
+
+    def _installed_value(args, kwargs):
+        """``(value, via_keyword)`` for either ``setattr`` call form.
+
+        pytest 7/8 spell the default sentinel ``notset`` and pytest 9 spells it
+        ``NOTSET``; parsing the call rather than importing the sentinel keeps
+        this working across both without a version probe.
+        """
+        if "value" in kwargs:
+            return kwargs["value"], True
+        if len(args) >= 3:  # setattr(target, name, value)
+            return args[2], False
+        if len(args) == 2:  # setattr("dotted.name", value)
+            return args[1], False
+        return missing, False
+
+    @functools.wraps(original)
+    def setattr_tracked(self, *args, **kwargs):
+        value, via_keyword = _installed_value(args, kwargs)
+        if (
+            not _in_spec_test()
+            or value is missing
+            or not callable(value)
+            or isinstance(value, type)
+        ):
+            return original(self, *args, **kwargs)
+        tracked = _Tracked(value)
+        if via_keyword:
+            kwargs = {**kwargs, "value": tracked}
+        elif len(args) >= 3:
+            args = (*args[:2], tracked, *args[3:])
+        else:
+            args = (args[0], tracked)
+        original(self, *args, **kwargs)
+        return tracked
+
+    setattr_tracked._mini_ork_tracking = True
+    MonkeyPatch.setattr = setattr_tracked
+
+
+_install_pytest_call_tracking()
