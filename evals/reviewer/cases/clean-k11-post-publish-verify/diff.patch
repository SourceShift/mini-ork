+    plan = _plan(tmp_path,
+                 'python3 tool.py verify --corpus "$MINI_ORK_RUN_DIR/source-corpus.json"')
+    assert sr.rule_named_test_path_exists(
+        plan, str(ws), str(root), run_dir=str(rd)) == ("pass", "2 named path(s) resolved")
