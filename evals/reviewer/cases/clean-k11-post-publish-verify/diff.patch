+def _dirs(tmp_path):
+    ws = tmp_path / "ws"
+    root = tmp_path / "root"
+    rd = tmp_path / "rd"
+    for d in (ws, root, rd):
+        d.mkdir()
+    return ws, root, rd
+
+
+def _plan(tmp_path, *commands):
+    path = tmp_path / "plan.json"
+    path.write_text(json.dumps({
+        "task_class": "code_fix",
+        "verifier_contract": {
+            "checks": [{"id": f"c{i + 1}", "command": cmd}
+                       for i, cmd in enumerate(commands)]
+        },
+    }), encoding="utf-8")
+    return str(path)
+
+
+def test_step_rules_run_dir_var_expands(tmp_path):
