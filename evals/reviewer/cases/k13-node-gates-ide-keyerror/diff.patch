-  # Synthesizer: authoritative composer. Runs serial after all lenses.
-  - { name: synthesizer,    type: reviewer,    model_lane: reviewer,     prompt_ref: prompts/synthesis.md,   dispatch_mode: serial,   gates: [budget_gate] }
