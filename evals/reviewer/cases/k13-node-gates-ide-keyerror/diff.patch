@@ -0,0 +1,66 @@
+version: "0.2.0"
+task_class: recursive_validate_impl
+description: >
+  Recursive implement to multi-tier-validate to reflect to replan loop.
+  Targets task classes where DoD probes are concrete and machine-checkable.
+  Hard-converges at DoD-pass, max_recursion, budget_exhaustion, or repeated
+  failure signatures.
+
+nodes:
+  - { name: planner, type: planner, model_lane: planner, prompt_ref: prompts/planner.md, dispatch_mode: serial }
+  - { name: implementer, type: implementer, model_lane: worker, prompt_ref: prompts/implementer.md, dispatch_mode: serial }
+  - { name: tier1_compile, type: verifier, verifier_ref: verifiers/tier1-compile-typecheck.py, dispatch_mode: serial }
+  - { name: tier2_unit, type: verifier, verifier_ref: verifiers/tier2-scoped-unit.py, dispatch_mode: serial }
+  - { name: tier3_property, type: verifier, verifier_ref: verifiers/tier3-property-mutation.py, dispatch_mode: serial }
+  # tier4 fans into 4 distinct-family lens nodes — Rajan 2025 submodularity
+  # + Nasser 2026 cross-family α=0.042 require heterogeneous panels.
+  # Standing directive 2026-06-12: no opus. Panel = glm + kimi + codex + minimax.
+  - { name: tier4_glm,     type: researcher, model_lane: glm_lens,     prompt_ref: prompts/tier4-panel-review.md, dispatch_mode: parallel }
+  - { name: tier4_kimi,    type: researcher, model_lane: kimi_lens,    prompt_ref: prompts/tier4-panel-review.md, dispatch_mode: parallel }
+  - { name: tier4_codex,   type: researcher, model_lane: codex_lens,   prompt_ref: prompts/tier4-panel-review.md, dispatch_mode: parallel }
+  - { name: tier4_minimax, type: researcher, model_lane: minimax_lens, prompt_ref: prompts/tier4-panel-review.md, dispatch_mode: parallel }
+  # tier4_quorum is a fail-fast gate added 2026-06-14. Without it, missing
+  # 2+ tier-4 lens reports caused tier4_synth to hang indefinitely (observed
+  # in run-1781333552-17796-identity-and-rbac + run-1781377882-65036-
+  # intervention-policies-gate). Default MO_TIER4_QUORUM=3 of 4 lenses.
+  - { name: tier4_quorum,  type: verifier,   verifier_ref: verifiers/tier4-panel-quorum.py, dispatch_mode: serial }
+  - { name: tier4_synth,   type: reviewer,   model_lane: reviewer,     prompt_ref: prompts/tier4-panel-synthesizer.md, dispatch_mode: serial }
+  - { name: reflector, type: reflector, model_lane: reflector, prompt_ref: prompts/reflector.md, dispatch_mode: serial }
+  - { name: replanner, type: planner, model_lane: planner, prompt_ref: prompts/replanner.md, dispatch_mode: serial }
+  - { name: publisher, type: publisher, prompt_ref: null, dispatch_mode: serial }
+  - { name: rollback, type: rollback, prompt_ref: null, dispatch_mode: serial }
+
+edges:
+  - { from: planner, to: implementer, edge_type: depends_on }
+  - { from: implementer, to: tier1_compile, edge_type: verifies }
+  - { from: tier1_compile, to: tier2_unit, edge_type: depends_on, condition: pass }
+  - { from: tier1_compile, to: reflector, edge_type: escalates_to, condition: fail }
+  - { from: tier2_unit, to: tier3_property, edge_type: depends_on, condition: pass }
+  - { from: tier2_unit, to: reflector, edge_type: escalates_to, condition: fail }
+  - { from: tier3_property, to: tier4_glm,     edge_type: depends_on, condition: pass }
+  - { from: tier3_property, to: tier4_kimi,    edge_type: depends_on, condition: pass }
+  - { from: tier3_property, to: tier4_codex,   edge_type: depends_on, condition: pass }
+  - { from: tier3_property, to: tier4_minimax, edge_type: depends_on, condition: pass }
+  - { from: tier3_property, to: reflector, edge_type: escalates_to, condition: fail }
+  - { from: tier4_glm,     to: tier4_quorum, edge_type: supplies_context_to }
+  - { from: tier4_kimi,    to: tier4_quorum, edge_type: supplies_context_to }
+  - { from: tier4_codex,   to: tier4_quorum, edge_type: supplies_context_to }
+  - { from: tier4_minimax, to: tier4_quorum, edge_type: supplies_context_to }
+  - { from: tier4_quorum,  to: tier4_synth, edge_type: depends_on, condition: pass }
+  - { from: tier4_quorum,  to: reflector,   edge_type: escalates_to, condition: fail }
+  - { from: tier4_synth, to: publisher, edge_type: depends_on, condition: pass }
+  - { from: tier4_synth, to: reflector, edge_type: escalates_to, condition: fail }
+  - { from: reflector, to: replanner, edge_type: depends_on }
+  - { from: replanner, to: implementer, edge_type: depends_on, recursive: true }
+
+recursion:
+  max_iterations: 5
+  convergence_check: all_dod_probes_pass
+  budget_cap_per_iter_usd: 20.00
+  budget_cap_total_usd: 60.00
+  divergence_kill: |
+    Iteration N+1 produces same verifier-fail signature as iteration N.
+    Detected by hashing the failure-log sorted by stage. Two identical
+    hashes in a row -> escalate to operator instead of looping forever.
+
+rollback_strategy: keep_partial_drain_discard_failed_iter
diff --git a/recipes/refactor-audit/workflow.yaml b/recipes/refactor-audit/workflow.yaml
