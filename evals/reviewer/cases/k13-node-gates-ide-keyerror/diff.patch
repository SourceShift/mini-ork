@@ -0,0 +1,34 @@
+# Three independent judges on three model families, then one synthesis.
+#
+# Lane choice: the three judge nodes ride the `*_lens` lanes (minimax_lens /
+# glm_lens / deepseek_lens) because those lanes exist exactly for
+# heterogeneous-family review — the user asked for MiniMax-M3, GLM-5.3, and
+# DeepSeek-Flash verdicts, and each family must judge alone so cross-family
+# disagreement is visible in the synthesis rather than averaged away by a
+# shared router. The synthesizer rides the `judge` lane (glm) on purpose:
+# synthesis is mechanical reconciliation, not a fourth vote, and keeping it
+# off the three judge families preserves "three families judged, one
+# composed" as a readable property of the panel.
+version: "1"
+task_class: session_task_judge
+
+nodes:
+  - { name: minimax_judge, type: researcher, model_lane: minimax_lens, prompt_ref: prompts/minimax-judge.md, dispatch_mode: parallel }
+  - { name: glm_judge, type: researcher, model_lane: glm_lens, prompt_ref: prompts/glm-judge.md, dispatch_mode: parallel }
+  - { name: deepseek_judge, type: researcher, model_lane: deepseek_lens, prompt_ref: prompts/deepseek-judge.md, dispatch_mode: parallel }
+  - { name: synthesizer, type: reviewer, model_lane: judge, prompt_ref: prompts/synthesis.md, dispatch_mode: serial }
+  - { name: panel_completeness, type: verifier, verifier_ref: verifiers/panel-completeness.py, dispatch_mode: serial }
+  - { name: publisher, type: publisher, prompt_ref: null, dispatch_mode: serial }
+  - { name: rollback, type: rollback, prompt_ref: null, dispatch_mode: serial }
+
+edges:
+  - { from: minimax_judge, to: synthesizer, edge_type: supplies_context_to }
+  - { from: glm_judge, to: synthesizer, edge_type: supplies_context_to }
+  - { from: deepseek_judge, to: synthesizer, edge_type: supplies_context_to }
+  - { from: synthesizer, to: panel_completeness, edge_type: verifies }
+  - { from: panel_completeness, to: publisher, edge_type: depends_on }
+  - { from: synthesizer, to: rollback, edge_type: escalates_to }
+  - { from: panel_completeness, to: rollback, edge_type: escalates_to }
+
+rollback_strategy: keep_judge_reports_discard_synthesis
+max_self_correction_iterations: 1
