+version: "0.1.0"
+task_class: recipe_authoring
+description: >
+  Meta-recipe: takes an epic kickoff and produces a new recipes/<derived>/
+  directory (workflow.yaml + prompts/ + verifiers/ + artifact_contract.yaml +
+  example-kickoff.md). Three family-diverse drafters propose, an opus arbiter
+  picks/merges, a verifier_smith generates task-specific bash verifiers, then a
+  recipe_validator enforces structure + heterogeneity-floor + dry-run before
+  publish. This is the framework dogfooding itself on small-N recipe authoring.
+
+nodes:
+  - { name: planner,          type: planner,    model_lane: planner,         prompt_ref: prompts/planner.md,           dispatch_mode: serial }
+
+  # Grounding lenses — independent evidence channels for the drafters
+  - { name: arxiv_lens,       type: researcher, model_lane: codex_lens,      prompt_ref: prompts/arxiv-lens.md,        dispatch_mode: parallel }
+  - { name: prior_art_lens,   type: researcher, model_lane: opus_lens,       prompt_ref: prompts/prior-art-lens.md,    dispatch_mode: parallel }
+
+  # Family-diverse drafters — each emits a candidate recipe directory under
+  # ${MINI_ORK_RUN_DIR}/drafts/<family>/. 3 distinct families satisfy the
+  # heterogeneity floor BEFORE the arbiter even picks.
+  - { name: minimax_drafter,      type: implementer, model_lane: minimax_lens,   prompt_ref: prompts/drafter-glm.md,       dispatch_mode: parallel }
+  - { name: kimi_drafter,     type: implementer, model_lane: kimi_lens,      prompt_ref: prompts/drafter-kimi.md,      dispatch_mode: parallel }
+  - { name: codex_drafter,    type: implementer, model_lane: codex_lens,     prompt_ref: prompts/drafter-codex.md,     dispatch_mode: parallel }
+
+  # Cross-family arbiter — different family from all 3 drafters
+  - { name: opus_arbiter,     type: reviewer,    model_lane: opus_lens,      prompt_ref: prompts/arbiter.md,           dispatch_mode: serial }
+
+  # Verifier_smith generates the task-specific bash verifiers for the
+  # chosen draft. Hybrid strategy: a template covers file-exists +
+  # workflow-parses; the smith adds task-specific assertions (e.g.
+  # success_criteria → file_exists mapping).
+  - { name: verifier_smith,   type: implementer, model_lane: codex,          prompt_ref: prompts/verifier-smith.md,    dispatch_mode: serial }
+
+  # Single combined validator: structure + heterogeneity (≥3 distinct
+  # families, HARD per user direction) + dry-run parse.
+  - { name: recipe_validator, type: verifier,    verifier_ref: verifiers/recipe-validator.py, dispatch_mode: serial }
+
+  - { name: publisher,        type: publisher,   prompt_ref: null,                          dispatch_mode: serial }
+  - { name: rollback,         type: rollback,    prompt_ref: null,                          dispatch_mode: serial }
+
+edges:
+  - { from: planner,         to: arxiv_lens,      edge_type: depends_on }
+  - { from: planner,         to: prior_art_lens,  edge_type: depends_on }
+  - { from: planner,         to: minimax_drafter,     edge_type: depends_on }
+  - { from: planner,         to: kimi_drafter,    edge_type: depends_on }
+  - { from: planner,         to: codex_drafter,   edge_type: depends_on }
+
+  - { from: arxiv_lens,      to: minimax_drafter,     edge_type: supplies_context_to }
+  - { from: arxiv_lens,      to: kimi_drafter,    edge_type: supplies_context_to }
+  - { from: arxiv_lens,      to: codex_drafter,   edge_type: supplies_context_to }
+  - { from: prior_art_lens,  to: minimax_drafter,     edge_type: supplies_context_to }
+  - { from: prior_art_lens,  to: kimi_drafter,    edge_type: supplies_context_to }
+  - { from: prior_art_lens,  to: codex_drafter,   edge_type: supplies_context_to }
+
+  - { from: minimax_drafter,     to: opus_arbiter,    edge_type: supplies_context_to }
+  - { from: kimi_drafter,    to: opus_arbiter,    edge_type: supplies_context_to }
+  - { from: codex_drafter,   to: opus_arbiter,    edge_type: supplies_context_to }
+
+  - { from: opus_arbiter,    to: verifier_smith,  edge_type: depends_on }
+  - { from: verifier_smith,  to: recipe_validator, edge_type: verifies }
+  - { from: recipe_validator, to: publisher,      edge_type: depends_on }
+  - { from: recipe_validator, to: rollback,       edge_type: escalates_to }
+  - { from: opus_arbiter,    to: rollback,        edge_type: escalates_to }
+
+rollback_strategy: keep_drafts_discard_chosen
+max_self_correction_iterations: 1
