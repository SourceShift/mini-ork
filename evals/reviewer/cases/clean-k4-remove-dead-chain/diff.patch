-def _last_iter_with_verdict(epic_dir: str) -> str | None:
-    for iter_dir in _iter_dirs(epic_dir):
-        if os.path.isfile(os.path.join(iter_dir, "verdict.json")):
-            m = _ITER_DIR_RE.match(os.path.basename(iter_dir))
-            if m is not None:
-                return m.group(1)
-    return None
