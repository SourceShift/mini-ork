# mini-ork CODEOWNERS
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-security/customizing-your-repository/about-code-owners
#
# Match patterns require approval from the listed handle(s) before a PR can merge.
# Ownership follows the active maintainers listed in MAINTAINERS.md — update this
# file whenever the maintainer set changes.

# Default — lead maintainer must approve any PR
*                              @amirkhakshour

# Framework primitives — extra scrutiny
/bin/                          @amirkhakshour
/lib/                          @amirkhakshour
/db/migrations/                @amirkhakshour
/schemas/                      @amirkhakshour
/hooks/                        @amirkhakshour

# Safety-critical paths — explicit lead approval required
/docs/SAFETY.md                @amirkhakshour
/db/migrations/0012_safety.sql @amirkhakshour
/mini_ork/gates/gate_registry.py @amirkhakshour
/mini_ork/gates/promotion_gate.py @amirkhakshour
/mini_ork/registries/version_registry.py @amirkhakshour

# Recipes — user-land, looser ownership (any reviewer can approve)
/recipes/                      @amirkhakshour

# Docs / governance — lead + any reviewer
/README.md                     @amirkhakshour
/CHANGELOG.md                  @amirkhakshour
/GOVERNANCE.md                 @amirkhakshour
/MAINTAINERS.md                @amirkhakshour
/ROADMAP.md                    @amirkhakshour
/RELEASING.md                  @amirkhakshour
