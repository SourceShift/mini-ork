#!/usr/bin/env python3
"""Deterministic stand-in for the agent CLI in the remote-nodes E2E plumbing
tier (no LLM spend). Every lane of the test run points here; the node's role
(MO_NODE_TYPE, published per node by the executor) picks the answer:

* implementer — applies the fixture's one-line fix in the cwd (the target
  checkout) and reports it as a unified diff, the way a text lane does: the
  publisher commits only a patch it can attribute to the implementer;
* reviewer — passes;
* anything else — a short acknowledgement.

MO_FAKE_AGENT_SLEEP=<s> makes it hang first (the kill_run test).
The prompt arrives on stdin and is read and ignored.
"""
import json
import os
import sys
import time
from pathlib import Path

BUG = "return sum(range(1, n))"
FIX = "return sum(range(1, n + 1))"


def main() -> int:
    try:
        sys.stdin.read()
    except (OSError, ValueError):
        pass
    if os.environ.get("MO_FAKE_AGENT_SLEEP"):
        time.sleep(float(os.environ["MO_FAKE_AGENT_SLEEP"]))
    role = os.environ.get("MO_NODE_TYPE", "")
    if role == "implementer":
        target = Path.cwd() / "calc_pkg" / "calc.py"
        if not target.is_file():
            print(f"mo-fake-agent: no calc_pkg/calc.py under {Path.cwd()}", file=sys.stderr)
            return 1
        original = target.read_text()
        target.write_text(original.replace(BUG, FIX))
        print("Fixed the off-by-one in calc_pkg/calc.py: range(1, n) -> range(1, n + 1).")
        # The publisher commits only a patch it can attribute to the implementer:
        # a transcript Write/Edit, or the unified diff the implementer emitted.
        # This stand-in edits the tree directly and leaves no transcript, so it
        # says what it changed the way a text lane does. `apply_impl_output`
        # will not re-apply it — it only runs when the tree is clean.
        if BUG in original and FIX not in original:
            sys.stdout.write(
                "--- a/calc_pkg/calc.py\n"
                "+++ b/calc_pkg/calc.py\n"
                "@@ -1,6 +1,6 @@\n"
                ' """Remote-nodes E2E fixture: one off-by-one, one failing test."""\n'
                " \n"
                " \n"
                " def total_upto(n):\n"
                '     """Sum of the integers 1..n inclusive."""\n'
                f"-    {BUG}\n"
                f"+    {FIX}\n"
            )
    elif role == "reviewer":
        print(json.dumps({"verdict": "pass", "summary": "one-line fix; test covers it"}))
    else:
        print(json.dumps({"verdict": "pass", "summary": f"ok ({role or 'unknown role'})"}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
